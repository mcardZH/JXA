	<suite name="Open Formats Suite" code="PSOs" description="Classes for specifying options when opening document">
		<class name="Camera RAW open options" code="CR01" description="Settings related to opening a camera RAW document" inherits="open options">
			<property name="bits per channel" code="DBch" type="e815" description="number of bits per channel"/>
			<property name="blue hue" code="CR32" type="integer" description="the blue hue of the shot"/>
			<property name="blue saturation" code="CR33" type="integer" description="the blue saturation of the shot"/>
			<property name="brightness" code="Bhtn" type="integer" description="the brightness of the shot"/>
			<property name="chromatic aberration by" code="CR24" type="integer" description="the chromatic aberration B/Y of the shot"/>
			<property name="chromatic aberration rc" code="CR23" type="integer" description="the chromatic aberration R/C of the shot"/>
			<property name="color noise reduction" code="CR22" type="integer" description="the color noise reduction of the shot"/>
			<property name="color space" code="ClSp" type="CR46" description="colorspace for image"/>
			<property name="contrast" code="CR19" type="integer" description="the constrast of the shot"/>
			<property name="exposure" code="CR17" type="real" description="the exposure of the shot"/>
			<property name="green hue" code="CR30" type="integer" description="the green hue of the shot"/>
			<property name="green saturation" code="CR31" type="integer" description="the green saturation of the shot"/>
			<property name="luminance smoothing" code="CR21" type="integer" description="the luminance smoothing of the shot"/>
			<property name="red hue" code="CR28" type="integer" description="the red hue of the shot"/>
			<property name="red saturation" code="CR29" type="integer" description="the red saturation of the shot"/>
			<property name="resolution" code="ResL" type="real" description="the resolution of the document (in pixels per inch)"/>
			<property name="saturation" code="pSat" type="integer" description="the saturation of the shot"/>
			<property name="settings" code="pPrf" type="CR02" description="global settings for all Camera RAW options ( default: camera default )"/>
			<property name="shadow tint" code="CR27" type="integer" description="the shadow tint of the shot"/>
			<property name="shadows" code="A501" type="integer" description="the shadows of the shot"/>
			<property name="sharpness" code="CR20" type="integer" description="the sharpness of the shot"/>
			<property name="size" code="ptsz" type="CR34" description="size of the new document"/>
			<property name="temperature" code="CR15" type="integer" description="the temperature of the shot"/>
			<property name="tint" code="CR16" type="integer" description="the tint of the shot"/>
			<property name="vignetting amount" code="CR25" type="integer" description="the vignetting amount of the shot"/>
			<property name="vignetting midpoint" code="CR26" type="integer" description="the vignetting mid point of the shot"/>
			<property name="white balance" code="CR14" type="CR05" description="white balance options for the image"/>
		</class>
		<class name="DICOM open options" code="cDCM" description="Settings related to opening a DICOM document" inherits="open options">
			<property name="anonymize" code="AnYm" type="boolean" description="Anonymize the patient information"/>
			<property name="columns" code="ColM" type="integer" description="The number of columns in n-up configuration"/>
			<property name="reverse" code="RvsE" type="boolean" description="Reverse(Invert) the image"/>
			<property name="rows" code="RoWs" type="integer" description="The number of rows in n-up configuration"/>
			<property name="show_overlays" code="OvLy" type="boolean" description="Show Overlays (if present)"/>
			<property name="windowlevel" code="WleV" type="integer" description="Window Level"/>
			<property name="windowwidth" code="WWiT" type="integer" description="Window Width"/>
		</class>
		<class name="EPS open options" code="cGES" description="Settings related to opening a generic EPS document" inherits="open options">
			<property name="constrain proportions" code="CPrP" type="boolean" description="constrain proportions of image"/>
			<property name="height" code="Hght" type="real" description="height of image (unit value)"/>
			<property name="mode" code="OMde" type="e900" description="the document mode"/>
			<property name="resolution" code="ResL" type="real" description="the resolution of the document (in pixels per inch)"/>
			<property name="use antialias" code="AnAl" type="boolean" description="use antialias?"/>
			<property name="width" code="Wdth" type="real" description="width of image (unit value)"/>
		</class>
		<class name="open options" code="cOpO" description="used with options on the open command"/>
		<class name="PDF open options" code="cGPF" description="Settings related to opening a generic PDF document" inherits="open options">
			<property name="bits per channel" code="DBch" type="e815" description="number of bits per channel"/>
			<property name="constrain proportions" code="CPrP" type="boolean" description="DEPRECATED, no longer used in CS2 ( constrain proportions of image )"/>
			<property name="crop page" code="crto" type="crtO" description="crop the page"/>
			<property name="height" code="Hght" type="real" description="DEPRECATED, no longer used in CS2  ( height of image (unit value) )"/>
			<property name="mode" code="OMde" type="e900" description="the document mode"/>
			<property name="name" code="pnam" type="text" description="name of the new document"/>
			<property name="object" code="pPTd" type="integer" description="number of 3d object to open"/>
			<property name="page" code="pPgN" type="integer" description="number of page or image to open"/>
			<property name="resolution" code="ResL" type="real" description="the resolution of the document (in pixels per inch)"/>
			<property name="suppress warnings" code="spwr" type="boolean" description="supress any warnings that may occur during opening"/>
			<property name="use 3d object number" code="pUTd" type="boolean" description="3d property refers to using 3d object, if false then UsePageNumber is used"/>
			<property name="use antialias" code="AnAl" type="boolean" description="use antialias?"/>
			<property name="use page number" code="pUPg" type="boolean" description="page property refers to page number, if false page property refers to image number"/>
			<property name="width" code="Wdth" type="real" description="DEPRECATED, no longer used in CS2  ( width of image (unit value) )"/>
		</class>
		<class name="Photo CD open options" code="cPCD" description="Settings related to opening a PhotoCD document" inherits="open options">
			<property name="color profile name" code="DcpN" type="text" description="profile to use when reading the image"/>
			<property name="color space" code="ClSp" type="e910" description="colorspace for image"/>
			<property name="orientation" code="Dori" type="Dori"/>
			<property name="pixel size" code="PxlZ" type="e810" description="dimensions of image"/>
			<property name="resolution" code="ResL" type="real" description="the resolution of the image (in pixels per inch)"/>
		</class>
		<class name="raw format open options" code="cRwF" description="Settings related to opening a raw format document" inherits="open options">
			<property name="bits per channel" code="DBch" type="integer" description="number of bits for each channel (8 or 16)"/>
			<property name="byte order" code="TfBo" type="e330" description="only relevant for images with 16 bits per channel"/>
			<property name="header size" code="HdSz" type="integer"/>
			<property name="height" code="Hght" type="integer" description="height of image (in pixels)"/>
			<property name="interleave channels" code="cOdr" type="boolean" description="are the channels in the image interleaved?"/>
			<property name="number of channels" code="ChNm" type="integer" description="number of channels in image"/>
			<property name="retain header" code="RtHd" type="boolean" description="retain header when saving?"/>
			<property name="width" code="Wdth" type="integer" description="width of image (in pixels)"/>
		</class>
		<enumeration name="e810" code="e810">
			<enumerator name="extra large" code="e811"/>
			<enumerator name="large" code="Lrge"/>
			<enumerator name="maximum" code="Maxi"/>
			<enumerator name="medium" code="Mdum"/>
			<enumerator name="minimum" code="Mini"/>
			<enumerator name="small" code="Smll"/>
		</enumeration>
	</suite>
	<suite name="Save Formats Suite" code="PSSs" description="Classes for specifying options when saving documents">
		<class name="BMP save options" code="cSBP" description="Settings related to saving a BMP document" inherits="save options">
			<property name="bits per sample" code="DBsm" type="e820" description="number of bits per sample ( default: twenty four )"/>
			<property name="flipped row order" code="FpRo" type="boolean"/>
			<property name="RLE compression" code="pRLE" type="boolean" description="should RLE compression be used?"/>
			<property name="save alpha channels" code="pSAc" type="boolean" description="save alpha channels"/>
			<property name="target operating system" code="pTOS" type="e191" description="target OS. Windows or OS/2 ( default: Windows )"/>
		</class>
		<class name="EPS save options" code="cSSP" description="Settings related to saving an EPS document" inherits="save options">
			<property name="embed color profile" code="pSEP" type="boolean" description="embed color profile in document"/>
			<property name="encoding" code="EnCd" type="e260" description="type of encoding to use for document ( default: binary )"/>
			<property name="halftone screen" code="HfTn" type="boolean" description="include halftone screen ( default: false )"/>
			<property name="image interpolation" code="ImIP" type="boolean" description="use image interpolation ( default: false )"/>
			<property name="PostScript color management" code="PsCM" type="boolean" description="use Postscript color management ( default: false )"/>
			<property name="preview type" code="PwTp" type="e250" description="type of preview ( default: monochrome TIFF )"/>
			<property name="transfer function" code="Tsfr" type="boolean" description="include transfer functions in document ( default: false )"/>
			<property name="transparent whites" code="TpWh" type="boolean" description="only valid when saving BitMap documents"/>
			<property name="vector data" code="VcDt" type="boolean" description="include vector data"/>
		</class>
		<class name="GIF save options" code="cSGF" description="Settings related to saving a GIF document" inherits="save options">
			<property name="colors in palette" code="pPCN" type="integer" description="number of colors in palette (only settable for some palette types)"/>
			<property name="dither" code="DtTp" type="e230" description="type of dither"/>
			<property name="dither amount" code="DtAm" type="integer" description="amount of dither. Only valid for diffusion ( 1 - 100; default: 75 )"/>
			<property name="forced colors" code="PFcl" type="e200"/>
			<property name="interlaced" code="RwOr" type="boolean" description="should rows be interlaced? ( default: false )"/>
			<property name="matte" code="Mtte" type="e880"/>
			<property name="palette" code="PPlt" type="e210" description="( default: local selective )"/>
			<property name="preserve exact colors" code="DPex" type="boolean"/>
			<property name="transparency" code="Trpc" type="boolean"/>
		</class>
		<class name="JPEG save options" code="cSJP" description="Settings related to saving a JPEG document" inherits="save options">
			<property name="embed color profile" code="pSEP" type="boolean" description="embed color profile in document"/>
			<property name="format options" code="JPOp" type="e270" description="( default: standard )"/>
			<property name="matte" code="Mtte" type="e880"/>
			<property name="quality" code="Qlty" type="integer" description="quality of produced image ( 0 - 12; default: 3 )"/>
			<property name="scans" code="Scns" type="integer" description="number of scans. Only valid for progressive type JPEG files ( 3 - 5 )"/>
		</class>
		<class name="PDF save options" code="cSPF" description="Settings related to saving a pdf document" inherits="save options">
			<property name="color conversion" code="PD30" type="boolean" description="convert the color profile to a destination profile"/>
			<property name="description" code="PD27" type="text" description="description of the save options in use"/>
			<property name="destination profile" code="PD22" type="text" description="describes the final RGB or CMYK output device, such as your monitor or a certain press standard"/>
			<property name="down sample" code="PD15" type="PD16" description="down sample method to use"/>
			<property name="down sample limit" code="PD29" type="real" description="limits downsampleing/subsampling to images that exceed this value (in pixels per inch)"/>
			<property name="down sample size" code="PD28" type="real" description="down sample images to this size if they exceed limit (in pixels per inch)"/>
			<property name="downgrade color profile" code="pDgP" type="boolean" description="DEPRECATED, no longer used in CS2 ( should the embedded color profile be downgraded to version 2 )"/>
			<property name="eight convert" code="PD21" type="boolean" description="converts a 16-bit image to 8-bit for better compatibility with other applications"/>
			<property name="embed color profile" code="pSEP" type="boolean" description="embed color profile in document"/>
			<property name="embed fonts" code="EmFt" type="boolean" description="DEPRECATED, no longer used in CS2 ( embed fonts? Only valid if a text layer is included )"/>
			<property name="embed thumbnail" code="PD14" type="boolean" description="Includes a small preview image in Acrobat"/>
			<property name="encoding" code="EnCd" type="e280" description="ZIP, JPEG and JPEG2000 encoding and compression options"/>
			<property name="image interpolation" code="ImIP" type="boolean" description="DEPRECATED, no longer used in CS2 ( use image interpolation? )"/>
			<property name="JPEG quality" code="PJpg" type="integer" description="Only valid for JPEG encoding. Use encoding options instead of this property. Quality of produced image. Only valid for JPEG encoded PDF documents ( 0 - 12 )"/>
			<property name="output condition" code="PD23" type="text" description="an optional comment field for inserting descriptions of the output condition. The text is stored in the PDF/X file."/>
			<property name="output condition id" code="PD24" type="text" description="identifier for the output condition"/>
			<property name="PDF compatibility" code="PD07" type="PD08" description="PDF version to be compatible with"/>
			<property name="PDF standard" code="PD06" type="PD01" description="PDF Standard to be compatible with"/>
			<property name="preserve editing" code="PD13" type="boolean" description="Lets you reopen the PDF in Photoshop with native Photoshop data intact"/>
			<property name="presetfile" code="pfil" type="text" description="preset file to use for settings, may override &apos;save as&apos; dialog settings"/>
			<property name="profile inclusion policy" code="PD31" type="boolean" description="shows which profiles to include"/>
			<property name="registry name" code="PD25" type="text" description="URL where the output condition is registered"/>
			<property name="save alpha channels" code="pSAc" type="boolean" description="save alpha channels"/>
			<property name="save annotations" code="pSAn" type="boolean" description="save annotations"/>
			<property name="save layers" code="pSLr" type="boolean" description="save layers"/>
			<property name="save spot colors" code="pSSs" type="boolean" description="save spot colors"/>
			<property name="tile size" code="PD20" type="integer" description="compression option supported only with JPEG2000 compression"/>
			<property name="transparency" code="Trpc" type="boolean" description="DEPRECATED, no longer used in CS2"/>
			<property name="use outlines for text" code="TxOl" type="boolean" description="DEPRECATED, no longer used in CS2 ( use outlines for text? Only valid if vector data is included )"/>
			<property name="vector data" code="VcDt" type="boolean" description="DEPRECATED, no longer used in CS2 ( include vector data )"/>
			<property name="view" code="PDF6" type="boolean" description="Opens the saved PDF in Acrobat"/>
			<property name="web optimize" code="PD26" type="boolean" description="Improves performance of PDFs on Web servers"/>
		</class>
		<class name="Photoshop DCS 1.0 save options" code="cSD1" description="Settings related to saving a Photoshop DCS 1.0 document" inherits="save options">
			<property name="DCS" code="DCsc" type="e340" description="( default: color composite )"/>
			<property name="embed color profile" code="pSEP" type="boolean" description="embed color profile in document"/>
			<property name="encoding" code="EnCd" type="e260" description="type of encoding to use for document ( default: binary )"/>
			<property name="halftone screen" code="HfTn" type="boolean" description="include halftone screen ( default: false )"/>
			<property name="image interpolation" code="ImIP" type="boolean" description="use image interpolation ( default: false )"/>
			<property name="preview type" code="PwTp" type="e250" description="type of preview ( default: eight bit Mac OS )"/>
			<property name="transfer function" code="Tsfr" type="boolean" description="include transfer functions in document ( default: false )"/>
			<property name="vector data" code="VcDt" type="boolean" description="include vector data"/>
		</class>
		<class name="Photoshop DCS 2.0 save options" code="cSD2" description="Settings related to saving a Photoshop DCS 2.0 document" inherits="save options">
			<property name="DCS" code="DCsc" type="e340" description="( default: no composite PostScript )"/>
			<property name="embed color profile" code="pSEP" type="boolean" description="embed color profile in document"/>
			<property name="encoding" code="EnCd" type="e260" description="type of encoding to use for document ( default: binary )"/>
			<property name="halftone screen" code="HfTn" type="boolean" description="include halftone screen ( default: false )"/>
			<property name="image interpolation" code="ImIP" type="boolean" description="use image interpolation ( default: false )"/>
			<property name="multifile DCS" code="DCmf" type="boolean" description="( default: false )"/>
			<property name="preview type" code="PwTp" type="e250" description="type of preview ( default: eight bit Mac OS )"/>
			<property name="save spot colors" code="pSSs" type="boolean" description="save spot colors"/>
			<property name="transfer function" code="Tsfr" type="boolean" description="include transfer functions in document ( default: false )"/>
			<property name="vector data" code="VcDt" type="boolean" description="include vector data"/>
		</class>
		<class name="Photoshop save options" code="cPSS" description="Settings related to saving a Photoshop document" inherits="save options">
			<property name="embed color profile" code="pSEP" type="boolean" description="embed color profile in document"/>
			<property name="save alpha channels" code="pSAc" type="boolean" description="save alpha channels"/>
			<property name="save annotations" code="pSAn" type="boolean" description="save annotations"/>
			<property name="save layers" code="pSLr" type="boolean" description="save layers"/>
			<property name="save spot colors" code="pSSs" type="boolean" description="save spot colors"/>
		</class>
		<class name="PICT file save options" code="cSPt" description="Settings related to saving a PICT document" inherits="save options">
			<property name="compression" code="pCmp" type="e290" description="( default: none )"/>
			<property name="embed color profile" code="pSEP" type="boolean" description="embed color profile in document"/>
			<property name="resolution" code="ResL" type="e840" description="number of bits per pixel"/>
			<property name="save alpha channels" code="pSAc" type="boolean" description="save alpha channels"/>
		</class>
		<class name="PICT resource save options" code="cSPr" description="Settings related to saving a PICT resource file" inherits="save options">
			<property name="compression" code="pCmp" type="e290" description="( default: none )"/>
			<property name="embed color profile" code="pSEP" type="boolean" description="embed color profile in document"/>
			<property name="name" code="pnam" type="text" description="name of PICT resource ( default: &quot;&quot; )"/>
			<property name="resolution" code="ResL" type="e840" description="number of bits per pixel"/>
			<property name="resource id" code="PtRD" type="integer" description="ID of PICT resource ( default: 128 )"/>
			<property name="save alpha channels" code="pSAc" type="boolean" description="save alpha channels"/>
		</class>
		<class name="Pixar save options" code="cSPi" description="Settings related to saving a Pixar document" inherits="save options">
			<property name="save alpha channels" code="pSAc" type="boolean" description="save alpha channels"/>
		</class>
		<class name="PNG save options" code="cSPG" description="Settings related to saving a PNG document" inherits="save options">
			<property name="compression" code="pCmp" type="integer" description="compression used on the image. ( 0 - 9; default: 0 )"/>
			<property name="interlaced" code="RwOr" type="boolean" description="should rows be interlaced? ( default: false )"/>
		</class>
		<class name="raw save options" code="cSRw" description="Settings related to saving a document in raw format" inherits="save options">
			<property name="save alpha channels" code="pSAc" type="boolean" description="save alpha channels"/>
			<property name="save spot colors" code="pSSs" type="boolean" description="save spot colors"/>
		</class>
		<class name="save options" code="BSop" description="used with options on the save command"/>
		<class name="SGI RGB save options" code="cSGG" description="Settings related to saving a document in the SGI RGB format" inherits="save options">
			<property name="save alpha channels" code="pSAc" type="boolean" description="save alpha channels"/>
			<property name="save spot colors" code="pSSs" type="boolean" description="save spot colors"/>
		</class>
		<class name="Targa save options" code="cSTg" description="Settings related to saving a Target document" inherits="save options">
			<property name="resolution" code="ResL" type="e845" description="number of bits per pixel ( default: twenty four )"/>
			<property name="RLE compression" code="pRLE" type="boolean" description="should RLE compression be used? ( default: true )"/>
			<property name="save alpha channels" code="pSAc" type="boolean" description="save alpha channels"/>
		</class>
		<class name="TIFF save options" code="cSTf" description="Settings related to saving a TIFF document" inherits="save options">
			<property name="byte order" code="TfBo" type="e330" description="Default value is &apos;Mac OS&apos; when running on MacOS, and &apos;IBM PC&apos; when running on a PC"/>
			<property name="embed color profile" code="pSEP" type="boolean" description="embed color profile in document"/>
			<property name="image compression" code="ImCp" type="e320" description="compression type ( default: none )"/>
			<property name="interleave channels" code="cOdr" type="boolean" description="are the channels in the image interleaved? ( default: true )"/>
			<property name="JPEG quality" code="PJpg" type="integer" description="quality of produced image. Only valid for JPEG compressed TIFF documents ( 0 - 12 )"/>
			<property name="layer compression" code="LyCp" type="e325" description="should only be used when you are saving layers"/>
			<property name="save alpha channels" code="pSAc" type="boolean" description="save alpha channels"/>
			<property name="save annotations" code="pSAn" type="boolean" description="save annotations"/>
			<property name="save image pyramid" code="pPYr" type="boolean" description="( default: false )"/>
			<property name="save layers" code="pSLr" type="boolean" description="save layers"/>
			<property name="save spot colors" code="pSSs" type="boolean" description="save spot colors"/>
			<property name="transparency" code="Trpc" type="boolean"/>
		</class>
		<enumeration name="e840" code="e840">
			<enumerator name="eight" code="Eigt"/>
			<enumerator name="four" code="Four"/>
			<enumerator name="sixteen" code="STen"/>
			<enumerator name="thirty two" code="Tty2"/>
			<enumerator name="two" code="Two "/>
		</enumeration>
		<enumeration name="e845" code="e845">
			<enumerator name="sixteen" code="STen"/>
			<enumerator name="thirty two" code="Tty2"/>
			<enumerator name="twenty four" code="TyFr"/>
		</enumeration>
		<enumeration name="e820" code="e820">
			<enumerator name="A1R5G5B5" code="e828"/>
			<enumerator name="A4R4G4B4" code="e831"/>
			<enumerator name="A8R8G8B8" code="e834"/>
			<enumerator name="eight" code="Eigt"/>
			<enumerator name="four" code="Four"/>
			<enumerator name="one" code="One "/>
			<enumerator name="R5G6B5" code="e829"/>
			<enumerator name="R8G8B8" code="e832"/>
			<enumerator name="sixteen" code="STen"/>
			<enumerator name="thirty two" code="Tty2"/>
			<enumerator name="twenty four" code="TyFr"/>
			<enumerator name="X1R5G5B5" code="e827"/>
			<enumerator name="X4R4G4B4" code="e830"/>
			<enumerator name="X8R8G8B8" code="e833"/>
		</enumeration>
	</suite>
	<suite name="Export Formats Suite" code="Exps" description="Classes for specifying options when exporting documents">
		<class name="export options" code="EOB " description="used with options on the export command"/>
		<class name="Illustrator paths export options" code="AiXp" description="Settings related to exporting Illustrator paths" inherits="export options">
			<property name="path name" code="TPnm" type="text" description="name of path to export. Only valid if you are exporting a named path"/>
			<property name="target path" code="TgPt" type="e650" description="which path to export ( default: document bounds )"/>
		</class>
		<class name="save for web export options" code="S4WC" description="Settings related to exporting Save For Web files" inherits="export options">
			<property name="blur" code="F001" type="real" description="apply blur to image to reduce artifacts ( default: 0.0 )"/>
			<property name="color reduction" code="S4W4" type="CR38" description="color reduction algorithm ( default: selective )"/>
			<property name="colors in palette" code="pPCN" type="integer" description="number of colors in palette ( default: 256 )"/>
			<property name="dither" code="DtTp" type="e230" description="type of dither ( default: diffusion )"/>
			<property name="dither amount" code="DtAm" type="integer" description="amount of dither. Only valid for diffusion ( default: 100 )"/>
			<property name="interlaced" code="RwOr" type="boolean" description="download in multiple passes, progressive ( default: false )"/>
			<property name="lossy" code="S4W3" type="integer" description="controls amount of lossiness allowed ( default: 0 )"/>
			<property name="matte" code="Mtte" type="RGB color" description="defines colors to blend transparent pixels against"/>
			<property name="optimized size" code="S4W8" type="boolean" description="creates smaller but less compatible files ( default: true )"/>
			<property name="png eight" code="S4W2" type="boolean" description="if the format is PNG how many bits, true = 8, false = 24 ( default: true )"/>
			<property name="quality" code="Qlty" type="integer" description="quality of produced image ( default: 60 )"/>
			<property name="transparency" code="Trpc" type="boolean" description="( default: true )"/>
			<property name="transparency amount" code="S4W6" type="integer" description="amount of transparency dither ( default: 100 )"/>
			<property name="transparency dither" code="S4W5" type="e230" description="transparency dither algorithm ( default: none )"/>
			<property name="web format" code="S4WB" type="SvFm" description="File format to use.  Note: Save For Web only supports Compuserve GIF, JPEG, PNG-8, PNG-24, and BMP formats. ( default: CompuServe GIF )"/>
			<property name="web snap" code="S4W7" type="integer" description="snaps close colors to web palette based on tolerance ( default: 0 )"/>
			<property name="with profile" code="S4W9" type="boolean" description="include an ICC profile based on Photoshop color compensation ( default: false )"/>
		</class>
	</suite>
	<suite name="Filter Suite" code="PFts" description="Scripting commands for applying filters to documents">
		<command name="filter" code="PFtsApft" description="apply a filter to one or more art layers">
			<direct-parameter type="art layer" description="the art layer object or objects to be operated upon"/>
			<parameter name="using" code="Usng" type="any" description="name of options class that the method should be invoked with. Must be a name of a class that inherits from filter options"/>
			<parameter name="with options" code="FmOp" type="filter options" optional="yes" description="options for method"/>
		</command>
		<class name="add noise" code="F018" description="apply the add noise filter" inherits="filter options">
			<property name="amount" code="Amnt" type="real"/>
			<property name="distribution" code="Dstr" type="e745"/>
			<property name="monochromatic" code="MChr" type="boolean"/>
		</class>
		<class name="average" code="F037" description="apply the average filter" inherits="filter options"/>
		<class name="blur" code="F001" description="apply the blur filter" inherits="filter options"/>
		<class name="blur more" code="F002" description="apply the blur more filter" inherits="filter options"/>
		<class name="clouds" code="F031" description="apply the clouds filter" inherits="filter options"/>
		<class name="custom filter" code="F026" description="apply the custom filter" inherits="filter options">
			<property name="characteristics" code="Crtx" description="filter characteristics (array of 25 values - Correspons to a left to right, top to bottom traversal of array presented in the Ui)">
				<type type="integer" list="yes"/>
			</property>
			<property name="scaling" code="Sclg" type="integer"/>
			<property name="offset" code="OfZt" type="integer"/>
		</class>
		<class name="deinterlace" code="F035" description="apply the de-interlace filter" inherits="filter options">
			<property name="eliminate" code="Elnt" type="e755"/>
			<property name="create new fields by" code="CrFl" type="e760"/>
		</class>
		<class name="despeckle" code="F019" description="apply the despeckle filter" inherits="filter options"/>
		<class name="difference clouds" code="F032" description="apply the difference clouds filter" inherits="filter options"/>
		<class name="diffuse glow" code="F006" description="apply the diffuse glow filter" inherits="filter options">
			<property name="graininess" code="Grns" type="integer" description="(range: 0 - 10)"/>
			<property name="glow amount" code="GlAm" type="integer" description="(range: 0 - 20)"/>
			<property name="clear amount" code="CLam" type="integer" description="(range: 0 - 20)"/>
		</class>
		<class name="displace filter" code="F015" description="apply the displace filter" inherits="filter options">
			<property name="horizontal scale" code="HrSc" type="integer"/>
			<property name="vertical scale" code="VtSc" type="integer"/>
			<property name="kind" code="Kind" type="e725"/>
			<property name="undefined areas" code="Udae" type="e715"/>
			<property name="displacement map definition" code="DpFl" type="alias"/>
		</class>
		<class name="dust and scratches" code="F020" description="apply the dust and scratches filter" inherits="filter options">
			<property name="radius" code="Radi" type="integer" description="in pixels"/>
			<property name="threshold" code="Thld" type="integer"/>
		</class>
		<class name="filter options" code="BsFt" description="options used with the filter method"/>
		<class name="gaussian blur" code="GBlr" description="apply the gaussian blur filter" inherits="filter options">
			<property name="radius" code="Radi" type="real" description="in pixels"/>
		</class>
		<class name="glass filter" code="F007" description="apply the glass filter" inherits="filter options">
			<property name="distortion" code="Dton" type="integer" description="(range: 0 - 20)"/>
			<property name="smoothness" code="StNs" type="integer" description="(range: 1 - 15)"/>
			<property name="scaling" code="Sclg" type="integer" description="(range: 50 - 200)"/>
			<property name="invert texture" code="ivTu" type="boolean" description="(default: false )"/>
			<property name="texture kind" code="Txkd" type="e690"/>
			<property name="texture definition" code="TxFl" type="alias"/>
		</class>
		<class name="high pass" code="F030" description="apply the high pass filter" inherits="filter options">
			<property name="radius" code="Radi" type="real" description="in pixels"/>
		</class>
		<class name="lens blur" code="LnBl" description="apply the lens blur filter" inherits="filter options">
			<property name="source" code="Di12" type="LB00" description="source for the depth map (default: none )"/>
			<property name="focal distance" code="LB11" type="integer" description="blur focal distance for the depth map (default: 0 )"/>
			<property name="invert depth map" code="LB15" type="boolean" description="invert the depth map (default: false )"/>
			<property name="iris shape" code="LB16" type="LB03" description="shape of the iris (default: hexagon )"/>
			<property name="radius" code="Radi" type="integer" description="radius of the iris (default: 15 )"/>
			<property name="blade curvature" code="LB13" type="integer" description="blade curvature of the iris (default: 0 )"/>
			<property name="rotation" code="LB14" type="integer" description="rotation of the iris (default: 0 )"/>
			<property name="brightness" code="Bhtn" type="integer" description="brightness for the specular highlights (default: 0 )"/>
			<property name="threshold" code="Thld" type="integer" description="threshold for the specular highlights (default: 0 )"/>
			<property name="amount" code="Amnt" type="integer" description="amount of noise (default: 0 )"/>
			<property name="distribution" code="Dstr" type="e745" description="distribution value for the noise (default: uniform )"/>
			<property name="monochromatic" code="MChr" type="boolean" description="is the noise monochromatic (default: false )"/>
		</class>
		<class name="lens flare" code="F033" description="apply the lens flare filter" inherits="filter options">
			<property name="brightness" code="Bhtn" type="integer" description="(range: 10 - 300)"/>
			<property name="flare center" code="FCtr" type="list" description="position (unit value)"/>
			<property name="lens type" code="LTpe" type="e750"/>
		</class>
		<class name="maximum filter" code="F027" description="apply the maximum filter" inherits="filter options">
			<property name="radius" code="Radi" type="real" description="in pixels"/>
		</class>
		<class name="median noise" code="F021" description="apply the median noise filter" inherits="filter options">
			<property name="radius" code="Radi" type="real" description="in pixels"/>
		</class>
		<class name="minimum filter" code="F028" description="apply the minimum filter" inherits="filter options">
			<property name="radius" code="Radi" type="real" description="in pixels"/>
		</class>
		<class name="motion blur" code="F003" description="apply the motion blur filter" inherits="filter options">
			<property name="angle" code="Angl" type="integer"/>
			<property name="radius" code="Radi" type="real" description="in pixels"/>
		</class>
		<class name="NTSC colors" code="F036" description="apply the NTSC colors filter" inherits="filter options"/>
		<class name="ocean ripple" code="F008" description="apply the ocean ripple filter" inherits="filter options">
			<property name="ripple size" code="RpSz" type="integer" description="(range: 1 - 15)"/>
			<property name="ripple magnitude" code="RpMg" type="integer" description="(range: 0 - 20)"/>
		</class>
		<class name="offset filter" code="F029" description="apply the offset filter" inherits="filter options">
			<property name="horizontal offset" code="HrOz" type="real" description="(unit value)"/>
			<property name="vertical offset" code="VtOz" type="real" description="(unit value)"/>
			<property name="undefined areas" code="Udae" type="e718"/>
		</class>
		<class name="pinch" code="F009" description="apply the pinch filter" inherits="filter options">
			<property name="amount" code="Amnt" type="integer" description="(range: -100 - 100)"/>
		</class>
		<class name="polar coordinates" code="F010" description="apply the polar coordinates filter" inherits="filter options">
			<property name="kind" code="Kind" type="e700"/>
		</class>
		<class name="radial blur" code="F004" description="apply the radial blur filter" inherits="filter options">
			<property name="amount" code="Amnt" type="integer" description="from 0 to 100"/>
			<property name="blur method" code="BMtd" type="e670"/>
			<property name="quality" code="Qlty" type="e675"/>
			<property name="blur center" code="Cntr" type="list" description="position (unit value)"/>
		</class>
		<class name="ripple" code="F011" description="apply the ripple filter" inherits="filter options">
			<property name="amount" code="Amnt" type="integer" description="(range: -999 - 999)"/>
			<property name="ripple size" code="RpSz" type="e710"/>
		</class>
		<class name="sharpen" code="F022" description="apply the sharpen filter" inherits="filter options"/>
		<class name="sharpen edges" code="F023" description="apply the sharpen edges filter" inherits="filter options"/>
		<class name="sharpen more" code="F024" description="apply the sharpen more filter" inherits="filter options"/>
		<class name="shear" code="F012" description="apply the shear filter" inherits="filter options">
			<property name="curve" code="Curv" description="specification of shear curve. List of curve points">
				<type type="any" list="yes"/>
			</property>
			<property name="undefined areas" code="Udae" type="e715"/>
		</class>
		<class name="smart blur" code="F005" description="apply the smart blur filter" inherits="filter options">
			<property name="radius" code="Radi" type="real" description="radius (range: 0 - 1000)"/>
			<property name="threshold" code="Thld" type="real" description="threshold (range: 0 - 1000)"/>
			<property name="quality" code="Qlty" type="e680"/>
			<property name="mode" code="OMde" type="e685"/>
		</class>
		<class name="spherize" code="F013" description="apply the spherize filter" inherits="filter options">
			<property name="amount" code="Amnt" type="integer" description="(range: -100 - 100)"/>
			<property name="mode" code="OMde" type="e720"/>
		</class>
		<class name="texture fill" code="F034" description="apply the texture fill filter" inherits="filter options">
			<property name="file path" code="Dpth" type="alias" description="texture file. Must be a grayscale Photoshop file"/>
		</class>
		<class name="twirl" code="F014" description="apply the twirl filter" inherits="filter options">
			<property name="angle" code="Angl" type="integer" description="(range: -999 - 999)"/>
		</class>
		<class name="unsharp mask" code="F025" description="apply the unsharp mask filter" inherits="filter options">
			<property name="amount" code="Amnt" type="real"/>
			<property name="radius" code="Radi" type="real" description="in pixels"/>
			<property name="threshold" code="Thld" type="integer" description="threshold"/>
		</class>
		<class name="wave filter" code="F016" description="apply the wave filter" inherits="filter options">
			<property name="number of generators" code="GrNm" type="integer" description="number of generators"/>
			<property name="minimum wavelength" code="MiWl" type="integer"/>
			<property name="maximum wavelength" code="MaWl" type="integer"/>
			<property name="minimum amplitude" code="MiAm" type="integer"/>
			<property name="maximum amplitude" code="MaAm" type="integer"/>
			<property name="horizontal scale" code="HrSc" type="integer"/>
			<property name="vertical scale" code="VtSc" type="integer"/>
			<property name="wave type" code="WvTp" type="e730"/>
			<property name="undefined areas" code="Udae" type="e715"/>
			<property name="random seed" code="RdSd" type="integer"/>
		</class>
		<class name="zigzag" code="F017" description="apply the zigzag filter" inherits="filter options">
			<property name="amount" code="Amnt" type="integer" description="(range: -100 - 100)"/>
			<property name="ridges" code="Rdgs" type="integer"/>
			<property name="style" code="Styl" type="e740"/>
		</class>
		<enumeration name="e670" code="e670">
			<enumerator name="spin" code="e671"/>
			<enumerator name="zoom" code="e672"/>
		</enumeration>
		<enumeration name="e675" code="e675">
			<enumerator name="best" code="e678"/>
			<enumerator name="draft" code="e676"/>
			<enumerator name="good" code="e677"/>
		</enumeration>
		<enumeration name="e680" code="e680">
			<enumerator name="high" code="e107"/>
			<enumerator name="low" code="e101"/>
			<enumerator name="medium" code="Mdum"/>
		</enumeration>
		<enumeration name="e685" code="e685">
			<enumerator name="edge only" code="e686"/>
			<enumerator name="normal" code="Nrml"/>
			<enumerator name="overlay edge" code="e687"/>
		</enumeration>
		<enumeration name="e690" code="e690">
			<enumerator name="blocks" code="e691"/>
			<enumerator name="canvas" code="e692"/>
			<enumerator name="frosted" code="e693"/>
			<enumerator name="texture document" code="e695"/>
			<enumerator name="tiny lens" code="e694"/>
		</enumeration>
		<enumeration name="e700" code="e700">
			<enumerator name="polar to rectangular" code="e702"/>
			<enumerator name="rectangular to polar" code="e701"/>
		</enumeration>
		<enumeration name="e710" code="e710">
			<enumerator name="large" code="Lrge"/>
			<enumerator name="medium" code="Mdum"/>
			<enumerator name="small" code="Smll"/>
		</enumeration>
		<enumeration name="e715" code="e715">
			<enumerator name="repeat edge pixels" code="e717"/>
			<enumerator name="wrap around" code="e716"/>
		</enumeration>
		<enumeration name="e718" code="e718">
			<enumerator name="repeat edge pixels" code="e717"/>
			<enumerator name="set to layer fill" code="e719"/>
			<enumerator name="wrap around" code="e716"/>
		</enumeration>
		<enumeration name="e720" code="e720">
			<enumerator name="horizontal" code="e141"/>
			<enumerator name="normal" code="Nrml"/>
			<enumerator name="vertical" code="e142"/>
		</enumeration>
		<enumeration name="e725" code="e725">
			<enumerator name="stretch to fit" code="e726"/>
			<enumerator name="tile" code="e727"/>
		</enumeration>
		<enumeration name="e730" code="e730">
			<enumerator name="sine" code="e731"/>
			<enumerator name="square" code="e733"/>
			<enumerator name="triangular" code="e732"/>
		</enumeration>
		<enumeration name="e740" code="e740">
			<enumerator name="around center" code="e741"/>
			<enumerator name="out from center" code="e742"/>
			<enumerator name="pond ripples" code="e743"/>
		</enumeration>
		<enumeration name="e745" code="e745">
			<enumerator name="Gaussian" code="e746"/>
			<enumerator name="uniform" code="e214"/>
		</enumeration>
		<enumeration name="e750" code="e750">
			<enumerator name="Movie Prime" code="e753"/>
			<enumerator name="Prime 105" code="e752"/>
			<enumerator name="Prime 35" code="e751"/>
			<enumerator name="zoom" code="e672"/>
		</enumeration>
		<enumeration name="e755" code="e755">
			<enumerator name="even fields" code="e757"/>
			<enumerator name="odd fields" code="e756"/>
		</enumeration>
		<enumeration name="e760" code="e760">
			<enumerator name="duplication" code="e761"/>
			<enumerator name="interpolation" code="e762"/>
		</enumeration>
	</suite>
	<suite name="Adjustment Suite" code="PAds" description="Scripting commands for applying adjustments to documents">
		<command name="adjust" code="PAdsAdDc" description="apply an adjustment to one or more art layers">
			<direct-parameter type="art layer" description="the art layer object or objects to be operated upon"/>
			<parameter name="using" code="Usng" type="any" description="name of options class that the method should be invoked with. Must be a name of a class that inherits from adjustment options"/>
			<parameter name="with options" code="FmOp" type="adjustment options" optional="yes" description="options for method"/>
		</command>
		<class name="adjustment options" code="BsAd" description="options used with the adjust method"/>
		<class name="automatic contrast" code="Ad02" description="adjust contrast of the selected channels automatically" inherits="adjustment options"/>
		<class name="automatic levels" code="AB01" description="adjust levels of the selected channels using auto levels option" inherits="adjustment options"/>
		<class name="brightness and contrast" code="Ad04" description="adjust brightness and constrast" inherits="adjustment options">
			<property name="brightness level" code="A401" type="integer"/>
			<property name="contrast level" code="A402" type="integer"/>
		</class>
		<class name="color balance" code="Ad05" inherits="adjustment options">
			<property name="shadows" code="A501" description="list of adjustments for shadows. There must be 3 values in the list">
				<type type="integer" list="yes"/>
			</property>
			<property name="midtones" code="A502" description="list of adjustments for midtones. There must be 3 values in the list">
				<type type="integer" list="yes"/>
			</property>
			<property name="highlights" code="A503" description="list of adjustments for highlights. There must be 3 values in the list">
				<type type="integer" list="yes"/>
			</property>
			<property name="preserve luminosity" code="A504" type="boolean"/>
		</class>
		<class name="curves" code="Ad03" description="adjust curves of the selected channels" inherits="adjustment options">
			<property name="curve points" code="A301" description="list of curve points (number of points must be between 2 and 14)">
				<type type="list" list="yes"/>
			</property>
		</class>
		<class name="desaturate" code="Ad06" inherits="adjustment options"/>
		<class name="equalize" code="Ad09" description="equalize the levels" inherits="adjustment options"/>
		<class name="inversion" code="iVon" description="inverts the currently selected layer or channels" inherits="adjustment options"/>
		<class name="levels adjustment" code="Ad01" description="adjust levels of the selected channels" inherits="adjustment options">
			<property name="input range start" code="A101" type="integer"/>
			<property name="input range end" code="A102" type="integer"/>
			<property name="input range gamma" code="A103" type="real"/>
			<property name="output range start" code="A104" type="integer"/>
			<property name="output range end" code="A105" type="integer"/>
		</class>
		<class name="mix channels" code="Ad08" description="only valid for RGB or CMYK documents" inherits="adjustment options">
			<property name="output channels" code="A803" description="list of channel specifications. For each component channel that the document has, you must specify a list of adjustment values followed by a &apos;constant&apos; value">
				<type type="any" list="yes"/>
			</property>
			<property name="monochrome mixing" code="A802" type="boolean" description="use monochrome mixing? If this is true you can only specify one channel value (default: false )"/>
		</class>
		<class name="photo filter" code="Ad13" inherits="adjustment options">
			<property name="with contents" code="FCnt" type="color value" description="a color to use for the fill"/>
			<property name="density" code="AC01" type="integer" description="density of the filter effect as a percent (default: 25 )"/>
			<property name="preserve luminosity" code="A504" type="boolean" description="(default: true )"/>
		</class>
		<class name="posterize" code="Ad10" inherits="adjustment options">
			<property name="levels" code="AA01" type="integer"/>
		</class>
		<class name="selective color" code="Ad07" inherits="adjustment options">
			<property name="selection method" code="A701" type="e890"/>
			<property name="reds" code="A702" description="Array of 4 values: cyan, magenta, yellow, black">
				<type type="real" list="yes"/>
			</property>
			<property name="yellows" code="A703" description="Array of 4 values: cyan, magenta, yellow, black">
				<type type="real" list="yes"/>
			</property>
			<property name="greens" code="A704" description="Array of 4 values: cyan, magenta, yellow, black">
				<type type="real" list="yes"/>
			</property>
			<property name="cyans" code="A705" description="Array of 4 values: cyan, magenta, yellow, black">
				<type type="real" list="yes"/>
			</property>
			<property name="blues" code="A706" description="Array of 4 values: cyan, magenta, yellow, black">
				<type type="real" list="yes"/>
			</property>
			<property name="magentas" code="A707" description="Array of 4 values: cyan, magenta, yellow, black">
				<type type="real" list="yes"/>
			</property>
			<property name="whites" code="A708" description="Array of 4 values: cyan, magenta, yellow, black">
				<type type="real" list="yes"/>
			</property>
			<property name="neutrals" code="A709" description="Array of 4 values: cyan, magenta, yellow, black">
				<type type="real" list="yes"/>
			</property>
			<property name="blacks" code="A710" description="Array of 4 values: cyan, magenta, yellow, black">
				<type type="real" list="yes"/>
			</property>
		</class>
		<class name="shadow highlight" code="SH01" inherits="adjustment options">
			<property name="shadow amount" code="SH02" type="integer" description="percentage from 0 to 100 (default: 50 )"/>
			<property name="shadow width" code="SH03" type="integer" description="percentage from 0 to 100 for tonal width (0 = narrow), (100 = broad) (default: 50 )"/>
			<property name="shadow radius" code="SH04" type="integer" description="pixel amount from 0 to 2500 (default: 30 )"/>
			<property name="highlight amount" code="SH05" type="integer" description="percentage from 0 to 100 (default: 0 )"/>
			<property name="highlight width" code="SH06" type="integer" description="percentage from 0 to 100 for tonal width (0 = narrow), (100 = broad) (default: 50 )"/>
			<property name="highlight radius" code="SH07" type="integer" description="pixel amount from 0 to 2500 (default: 30 )"/>
			<property name="color correction" code="SH08" type="integer" description="adjust the colors in the changed portion of the image (-100 to 100) (default: 20 )"/>
			<property name="midtone contrast" code="SH09" type="integer" description="amount for the midtone contrast (-100 to 100) (default: 0 )"/>
			<property name="black clip" code="SH10" type="real" description="fractions of whites to be clipped (default: 0.01 )"/>
			<property name="white clip" code="SH11" type="real" description="fractions of blacks to be clipped (default: 0.01 )"/>
		</class>
		<class name="threshold adjustment" code="Ad11" inherits="adjustment options">
			<property name="level" code="AA01" type="integer"/>
		</class>
	</suite>
	<suite name="Color Suite" code="PCls" description="Color classes for Adobe Photoshop">
		<command name="convert color" code="PClsCvCl" description="convert a object from one color model to another">
			<direct-parameter type="color value" description="color to convert"/>
			<parameter name="to" code="to  " type="e930" description="color model to convert to"/>
			<result type="color value" description="convert a object from one color model to another"/>
		</command>
		<command name="equal colors" code="PClsClEq" description="are the colors visually equal?">
			<direct-parameter type="color value" description="The original color with which to compare."/>
			<parameter name="with" code="with" type="color value" description="The color to which to compare the original color."/>
			<result type="boolean" description="are the colors visually equal?"/>
		</command>
		<command name="web safe color" code="PClsFWcl" description="find the closest web safe color for a color">
			<parameter name="for" code="for " type="color value" description="Color for which to find the closest web safe color."/>
			<result type="RGB color" description="find the closest web safe color for a color"/>
		</command>
		<class name="CMYK color" code="cCMv" description="A CMYK color specification" inherits="color value">
			<property name="cyan" code="pCCv" type="real" description="the cyan color value (between 0.0 and 100.0)"/>
			<property name="magenta" code="pCMv" type="real" description="the magenta color value (between 0.0 and 100.0)"/>
			<property name="yellow" code="pCYv" type="real" description="the yellow color value (between 0.0 and 100.0)"/>
			<property name="black" code="pCKv" type="real" description="the black color value (between 0.0 and 100.0)"/>
		</class>
		<class name="color value" code="BsCl" description="A color value"/>
		<class name="gray color" code="cGrv" description="A gray color specification" inherits="color value">
			<property name="gray value" code="pGrv" type="real" description="the gray value ( 0.0 - 100.0; default: 0.0 )"/>
		</class>
		<class name="HSB color" code="cHBv" description="An HSB color specification" inherits="color value">
			<property name="hue" code="pHue" type="real" description="the hue value (between 0.0 and 360.0)"/>
			<property name="saturation" code="pSat" type="real" description="the saturation value (between 0.0 and 100.0)"/>
			<property name="brightness" code="Bhtn" type="real" description="the brightness value (between 0.0 and 100.0)"/>
		</class>
		<class name="Lab color" code="cLbv" description="An Lab color specification" inherits="color value">
			<property name="value_L" code="pLbL" type="real" description="the L-value (between 0.0 and 100.0)"/>
			<property name="value_a" code="pLba" type="real" description="the a-value (between -128.0 and 127.0)"/>
			<property name="value_b" code="pLbb" type="real" description="the b-value (between -128.0 and 127.0)"/>
		</class>
		<class name="no color" code="cNCl" description="represents a missing color" inherits="color value"/>
		<class name="RGB color" code="cRGv" description="An RGB color specification" inherits="color value">
			<property name="red" code="pRRv" type="real" description="the red color value ( 0.0 - 255.0; default: 255.0 )"/>
			<property name="green" code="pRGv" type="real" description="the green color value ( 0.0 - 255.0; default: 255.0 )"/>
			<property name="blue" code="pRBv" type="real" description="the blue color value ( 0.0 - 255.0; default: 255.0 )"/>
		</class>
		<class name="RGB hex color" code="cRHv" description="A hexadecimal specification of an RGB color" inherits="color value">
			<property name="hex value" code="pHxv" type="text" description="the hex representation of the color. (Example &apos;10FF4B&apos;)"/>
		</class>
	</suite>
	<suite name="Path Suite" code="Pats" description="Classes for working with art path items">
		<command name="create selection" code="PatsPT13" description="make a selection from this path">
			<direct-parameter type="path item" description="the path item object or objects to be operated upon"/>
			<parameter name="feather amount" code="FAmt" type="real" optional="yes" description="the feather amount in pixels"/>
			<parameter name="antialiasing" code="UsAA" type="boolean" optional="yes" description="use anti aliasing for the selection"/>
			<parameter name="operation" code="PT07" type="e630" optional="yes" description="the operation mode for the selection"/>
		</command>
		<command name="deselect" code="PatsDslt" description="unselect this path item, no paths items are selected">
			<direct-parameter type="path item" description="the path item object or objects to be operated upon"/>
		</command>
		<command name="fill path" code="PatsPT14" description="fill the path with the following information">
			<direct-parameter type="path item" description="the path item object or objects to be operated upon"/>
			<parameter name="with contents" code="FCnt" type="any" optional="yes" description="color of the fill for this path"/>
			<parameter name="blend mode" code="BlMd" type="e925" optional="yes" description="blending mode of the fill for this path"/>
			<parameter name="opacity" code="Opct" type="real" optional="yes" description="opacity of the fill for this path"/>
			<parameter name="preserving transparency" code="KpTr" type="boolean" optional="yes" description="preserve the transparency of the file for this path"/>
			<parameter name="feather amount" code="FAmt" type="real" optional="yes" description="the feather amount in pixels"/>
			<parameter name="antialiasing" code="UsAA" type="boolean" optional="yes" description="use anti aliasing for the selection"/>
			<parameter name="whole path" code="WoPt" type="boolean" optional="yes" description="use all subpaths when doing fill"/>
		</command>
		<command name="make clipping path" code="PatsPT17" description="make this path item the clipping path for this document">
			<direct-parameter type="path item" description="the path item object or objects to be operated upon"/>
			<parameter name="flatness" code="PT10" type="real" optional="yes" description="Flatness in device pixels.  Tells the PostScript printer how to approximate curves. (0.2 - 100)."/>
		</command>
		<command name="select" code="Patsslct" description="make this path item the active or selected path item">
			<direct-parameter type="path item" description="the path item object or objects to be operated upon"/>
		</command>
		<command name="stroke path" code="PatsPT15" description="stroke the path with the following information">
			<direct-parameter type="path item" description="the path item object or objects to be operated upon"/>
			<parameter name="tool" code="PT08" type="PT23" optional="yes" description="tool to use when stroking the path"/>
			<parameter name="simulate pressure" code="PT09" type="boolean" optional="yes" description="simulate the pressure when using the tool"/>
		</command>
		<class name="path item" code="PT03" description="An artwork path item" plural="path items">
			<element type="sub path item"/>
			<property name="best type" code="pbst" type="type" access="r" description="the best type for the object&apos;s value"/>
			<property name="class" code="pcls" type="type" access="r" description="the object&apos;s class"/>
			<property name="default type" code="deft" type="type" access="r" description="the default type for the object&apos;s value"/>
			<property name="index" code="pidx" type="integer" access="r" description="the index of this instance of the object"/>
			<property name="properties" code="pALL" type="record" description="all of this object&apos;s properties returned in a single record"/>
			<property name="container" code="ctnr" type="specifier" access="r" description="the object&apos;s container"/>
			<property name="entire path" code="PT52" access="r" description="all the path item&apos;s sub paths">
				<type type="sub path info" list="yes"/>
			</property>
			<property name="kind" code="Kind" type="PT21"/>
			<property name="name" code="pnam" type="text" description="the name of the path item"/>
		</class>
		<class name="path point" code="PT04" description="A point on a path" plural="path points">
			<property name="best type" code="pbst" type="type" access="r" description="the best type for the object&apos;s value"/>
			<property name="class" code="pcls" type="type" access="r" description="the object&apos;s class"/>
			<property name="default type" code="deft" type="type" access="r" description="the default type for the object&apos;s value"/>
			<property name="index" code="pidx" type="integer" access="r" description="the index of this instance of the object"/>
			<property name="properties" code="pALL" type="record" description="all of this object&apos;s properties returned in a single record"/>
			<property name="anchor" code="PT18" type="list" access="r" description="the position (coordinates) of the anchor point"/>
			<property name="container" code="ctnr" type="specifier" access="r" description="the object&apos;s container"/>
			<property name="kind" code="Kind" type="PT22" access="r" description="the type of point: smooth/corner"/>
			<property name="left direction" code="PT19" type="list" access="r" description="location of the left direction point (in position)"/>
			<property name="right direction" code="PT20" type="list" access="r" description="location of the right direction point (out position)"/>
		</class>
		<class name="path point info" code="PT53" description="Path point information (returned by entire path dataClassProperty of path item class)">
			<property name="anchor" code="PT18" type="list" description="the position of the anchor (in coordinates)"/>
			<property name="kind" code="Kind" type="PT22" description="the point type, smooth/corner"/>
			<property name="left direction" code="PT19" type="list" description="location of the left direction point (in position)"/>
			<property name="right direction" code="PT20" type="list" description="location of the right direction point (out position)"/>
