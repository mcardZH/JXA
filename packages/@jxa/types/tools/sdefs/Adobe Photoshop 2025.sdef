<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary>
	<suite name="AdobeScriptAutomation" code="adSU" description="Adobe Photoshop script execution menu">
		<command name="$$$/AETE/Scripts=Scripts" code="adSUdJsc" description="Photoshop scripting support plugin">
			<direct-parameter type="#ImR" optional="yes"/>
			<parameter name="$$$/JavaScript/Name=Name" code="jsNm" type="text" description="The JavaScript name to execute"/>
			<parameter name="$$$/JavaScript/File=File" code="jsCt" type="text" description="The JavaScript file to execute"/>
			<parameter name="$$$/JavaScript/Text=Text" code="jsTx" type="text" description="The JavaScript text to execute"/>
			<parameter name="$$$/JavaScript/Debugging=Debugging" code="XMde" type="boolean" description="should the javascript be executed in debug mode?"/>
			<parameter name="$$$/JavaScript/Message=Message" code="Msge" type="text" description="the JavaScript parameters"/>
		</command>
		<enumeration name="dbex" code="dbex">
			<enumerator name="never show debugger" code="hnsd" description="never show debugger"/>
			<enumerator name="show on error" code="hdoe" description="show on error"/>
			<enumerator name="show before running" code="hbr " description="show before running"/>
		</enumeration>
	</suite>
	<suite name="Core Suite" code="PsCS" description="Suite that applies to all applications">
		<command name="count" code="corecnte" description="Return the number of elements of a particular class within an object">
			<direct-parameter type="specifier" description="the object whose elements are to be counted"/>
			<parameter name="each" code="kocl" type="type" description="the class of the elements to be counted."/>
			<result type="integer" description="the number of elements"/>
		</command>
		<command name="delete" code="coredelo" description="Remove an element from an object">
			<direct-parameter type="specifier" description="the element to delete"/>
		</command>
		<command name="duplicate" code="coreclon" description="Duplicate one or more object(s)">
			<direct-parameter type="specifier" description="the object(s) to duplicate"/>
			<parameter name="to" code="insh" type="location specifier" optional="yes" description="the new location for the object(s)"/>
			<parameter name="with properties" code="prdt" type="record" optional="yes" description="new values for the properties of the duplicated element"/>
			<result type="specifier" description="to the duplicated object(s)"/>
		</command>
		<command name="exists" code="coredoex" description="Verify if an object exists">
			<direct-parameter type="specifier" description="the object in question"/>
			<result type="boolean" description="true if it exists, false if not"/>
		</command>
		<command name="make" code="corecrel" description="Make a new element">
			<parameter name="new" code="kocl" type="type" description="the class of the new element."/>
			<parameter name="at" code="insh" type="location specifier" description="the location at which to insert the element"/>
			<parameter name="with data" code="data" type="any" optional="yes" description="the initial data for the element"/>
			<parameter name="with properties" code="prdt" type="record" optional="yes" description="the initial values for the properties of the element"/>
			<result type="specifier" description="to the new object(s)"/>
		</command>
		<command name="move" code="coremove" description="Move object(s) to a new location">
			<direct-parameter type="specifier" description="the object(s) to move"/>
			<parameter name="to" code="insh" type="location specifier" description="the new location for the object(s)"/>
			<result type="specifier" description="to the object(s) after they have been moved"/>
		</command>
		<command name="close" code="PsCSclos" description="close the document">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="saving" code="savo" type="savo" optional="yes" description="specifies whether changes should be saved before closing ( default: ask )"/>
		</command>
		<command name="duplicate" code="PsCSclon" description="duplicate this document without parameters">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<result type="document" description="duplicate this document without parameters"/>
		</command>
		<command name="open" code="PsCSodoc" description="open the specified document file(s)">
			<direct-parameter type="any" description="the file(s) to be opened"/>
			<parameter name="as" code="fltp" type="OpAs" optional="yes" description="open document as the specified type"/>
			<parameter name="with options" code="FmOp" type="open options" optional="yes" description="options for the file type specified"/>
			<parameter name="showing dialogs" code="ShwD" type="e050" optional="yes" description="should a dialog be displayed when a file is opened"/>
			<parameter name="smart object" code="asso" type="boolean" optional="yes" description="create a smart object around the document being opened ( default: false )"/>
		</command>
		<command name="print" code="PsCSpdoc" description="print the specified object(s)">
			<direct-parameter type="any" description="the file(s) or document(s) to be printed"/>
			<parameter name="source space" code="SrSp" type="e945" optional="yes" description="color space for source ( default: document space )"/>
			<parameter name="print space" code="PrSp" type="text" optional="yes" description="color space for printer. Can be nothing (meaning same as source) or a string specifying a specific color profile"/>
			<parameter name="intent" code="Itnt" type="e130" optional="yes" description="if the print space is different from the source space, this argument will be used as the color conversion intent ( default: relative colorimetric )"/>
			<parameter name="blackpoint compensation" code="BpCp" type="boolean" optional="yes" description="if the print space is different from the source space, this argument indicates if the color conversion should use black point compensation ( default: true )"/>
		</command>
		<command name="quit" code="PsCSquit" description="quit the application"/>
		<command name="save" code="PsCSsave" description="save the specified document">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="in" code="kfil" type="file specification" optional="yes" description="the file to save the document in"/>
			<parameter name="as" code="fltp" type="SvFm" optional="yes" description="The file type to save the document as.  Note: Wireless Bitmap format not supported, for that format, use export and save for web."/>
			<parameter name="copying" code="SaCp" type="boolean" optional="yes" description="save as copy leaving original open. Unsaved files cannot be saved as copy"/>
			<parameter name="appending" code="DcXt" type="e300" optional="yes" description="append an extension to the document name"/>
			<parameter name="with options" code="FmOp" type="save options" optional="yes" description="options for the file type specified"/>
			<result type="document" description="save the specified document"/>
		</command>
		<class name="application" code="capp" description="The Adobe Photoshop application">
			<element type="document"/>
			<element type="font"/>
			<element type="notifier"/>
			<property name="best type" code="pbst" type="type" access="r" description="the best type for the object&apos;s value"/>
			<property name="class" code="pcls" type="type" access="r" description="the object&apos;s class"/>
			<property name="default type" code="deft" type="type" access="r" description="the default type for the object&apos;s value"/>
			<property name="properties" code="pALL" type="record" description="all of this object&apos;s properties returned in a single record"/>
			<property name="background color" code="BgCr" type="color value"/>
			<property name="build" code="Bild" type="text" access="r" description="the build number of Adobe Photoshop application"/>
			<property name="color settings" code="Cset" type="any" description="name of selected color settings&apos; set"/>
			<property name="current document" code="pADc" type="document" description="the frontmost document"/>
			<property name="current tool" code="cTol" type="text" description="name of the current tool"/>
			<property name="display dialogs" code="AUiL" type="e050" description="controls whether or not Photoshop displays dialogs"/>
			<property name="foreground color" code="FgCr" type="color value"/>
			<property name="free memory" code="pFMM" type="real" access="r" description="the amount of unused memory available to Adobe Photoshop"/>
			<property name="frontmost" code="pFmt" type="boolean" access="r" description="is Photoshop the frontmost application?"/>
			<property name="locale" code="lcal" type="text" access="r" description="language locale of application"/>
			<property name="macintosh file types" code="mtft" access="r" description="list of file image types Photoshop can open">
				<type type="text" list="yes"/>
			</property>
			<property name="name" code="pnam" type="text" access="r" description="the application&apos;s name"/>
			<property name="notifiers enabled" code="EN06" type="boolean" description="enable or disable all notifiers"/>
			<property name="preferences folder" code="prfl" type="alias" access="r" description="full path to the preferences folder"/>
			<property name="recent files" code="rcfl" access="r" description="files in the recent file list">
				<type type="file specification" list="yes"/>
			</property>
			<property name="scripting build date" code="sbld" type="text" access="r" description="the build date of the scripting interface"/>
			<property name="scripting version" code="pSvs" type="text" access="r" description="the version of the Scripting interface"/>
			<property name="settings" code="pPrf" type="settings-object" access="r" description="preference settings"/>
			<property name="system information" code="SysI" type="text" access="r" description="system information of the host application and machine"/>
			<property name="version" code="vers" type="text" access="r" description="the version of Adobe Photoshop application"/>
			<property name="windows file types" code="wnft" access="r" description="list of file image extensions Photoshop can open">
				<type type="text" list="yes"/>
			</property>
		</class>
		<class name="document" code="docu" description="A document" plural="documents">
			<element type="art layer"/>
			<element type="channel"/>
			<element type="color sampler"/>
			<element type="count item"/>
			<element type="history state"/>
			<element type="layer comp"/>
			<element type="layer"/>
			<element type="layer set"/>
			<element type="path item"/>
			<property name="best type" code="pbst" type="type" access="r" description="the best type for the object&apos;s value"/>
			<property name="class" code="pcls" type="type" access="r" description="the object&apos;s class"/>
			<property name="default type" code="deft" type="type" access="r" description="the default type for the object&apos;s value"/>
			<property name="index" code="pidx" type="integer" access="r" description="the index of this instance of the object"/>
			<property name="properties" code="pALL" type="record" description="all of this object&apos;s properties returned in a single record"/>
			<property name="background layer" code="DbLr" type="art layer" access="r" description="The background layer for the document. Only valid for documents that have a background layer"/>
			<property name="bits per channel" code="DBch" type="e815" description="number of bits per channel"/>
			<property name="color profile kind" code="DcpT" type="e090" description="Type of color profile management for document.  Note: If you want to set a custom color profile, do not set a value for color profile kind; rather, set the appropriate color profile name."/>
			<property name="color profile name" code="DcpN" type="text" description="Name of color profile for document. Valid when no value is specified for color profile kind (to indicate a custom color profile)."/>
			<property name="component channels" code="CCps" access="r" description="all color component channels for this document">
				<type type="channel" list="yes"/>
			</property>
			<property name="current channels" code="DCnl" description="selected channels for document">
				<type type="channel" list="yes"/>
			</property>
			<property name="current history brush source" code="DCbr" type="history state" description="the current history state to use with the history brush for this document"/>
			<property name="current history state" code="DChs" type="history state" description="the current history state for this document"/>
			<property name="current layer" code="crLr" type="layer" description="selected layer for document"/>
			<property name="file path" code="Dpth" type="alias" access="r" description="full path name of document"/>
			<property name="height" code="Hght" type="real" access="r" description="height of document (unit value)"/>
			<property name="histogram" code="Hist" access="r" description="a histogram of values for the composite document (only for RGB, CMYK and &apos;Indexed colors&apos; documents)">
				<type type="integer" list="yes"/>
			</property>
			<property name="id" code="ID  " type="integer" access="r" description="the unique ID of this document"/>
			<property name="info" code="Dinf" type="info-object" access="r" description="document information"/>
			<property name="initial fill" code="DiFl" type="e110" access="r" description="initial fill of the document. Only valid when used as an option with the &apos;make new document&apos; command"/>
			<property name="managed" code="dMgd" type="boolean" access="r" description="is the document a workgroup document?"/>
			<property name="measurement scale" code="cMSc" type="measurement scale" access="r" description="The measurement scale of the document"/>
			<property name="mode" code="OMde" type="e080" access="r" description="document mode"/>
			<property name="modified" code="Dmdf" type="boolean" access="r" description="has the document been modified since last save?"/>
			<property name="name" code="pnam" type="text" access="r" description="the document&apos;s name"/>
			<property name="pixel aspect ratio" code="Di26" type="real" description="the pixel aspect ration of the document"/>
			<property name="quick mask mode" code="QMMd" type="boolean" description="is the document in the quick mask mode?"/>
			<property name="resolution" code="ResL" type="real" access="r" description="the resolution of the document (in pixels per inch)"/>
			<property name="selection" code="sele" type="selection-object" access="r" description="the document&apos;s selection"/>
			<property name="width" code="Wdth" type="real" access="r" description="width of document (unit value)"/>
			<property name="XMP metadata" code="cXMd" type="XMP metadata" access="r" description="XMP metadata associated with the document"/>
		</class>
		<enumeration name="e815" code="e815">
			<enumerator name="eight" code="Eigt"/>
			<enumerator name="one" code="One "/>
			<enumerator name="sixteen" code="STen"/>
			<enumerator name="thirty two" code="Tty2"/>
		</enumeration>
	</suite>
	<suite name="Photoshop Suite" code="8BIM" description="Scripting commands and classes for Adobe Photoshop">
		<command name="Photoshop open dialog" code="8BIMpsop" description="use the Photoshop open dialog to select files">
			<result description="use the Photoshop open dialog to select files">
				<type type="file specification" list="yes"/>
			</result>
		</command>
		<command name="apply" code="8BIMPG01" description="apply the layer comp to the document">
			<direct-parameter type="layer comp" description="the layer comp object or objects to be operated upon"/>
		</command>
		<command name="apply layer style" code="8BIMApLs">
			<direct-parameter type="art layer" description="the art layer object or objects to be operated upon"/>
			<parameter name="using" code="Usng" type="text" description="name of the layer style to apply"/>
		</command>
		<command name="auto count" code="8BIMCT05" description="automatically counts the objects in an image">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="from" code="from" type="channel" description="channel to use for counting"/>
			<parameter name="threshold" code="Thld" type="integer" description="threshold to use for counting (range: 0-255) ( 0 - 255 )"/>
		</command>
		<command name="batch" code="8BIMBT01" description="run the batch automation routine">
			<direct-parameter type="text" description="the name of the action to play (note that the case of letters in the Action name is important and must match the case of the name in the Actions palette)"/>
			<parameter name="from files" code="PDF2" description="list of input files to operate on">
				<type type="alias" list="yes"/>
			</parameter>
			<parameter name="from" code="from" type="text" description="the name of the action set containing the action being played (note that the case of letters in the Action Set name is important and must match the case of the name in the Actions palette)"/>
			<parameter name="with options" code="FmOp" type="batch options" optional="yes" description="options for Batch"/>
			<result type="text" description="run the batch automation routine"/>
		</command>
		<command name="change mode" code="8BIMChCs" description="change the mode of the document">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="to" code="to  " type="e089" description="name of mode to change to"/>
			<parameter name="with options" code="FmOp" type="change mode options" optional="yes" description="options for changing the mode"/>
		</command>
		<command name="contract" code="8BIMSCtr" description="contracts the selection">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="by" code="by  " type="real" description="distance to contract the selection by (unit value)"/>
		</command>
		<command name="convert" code="8BIMCvPr" description="convert the document from using one color profile to using an other">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="to profile" code="DsPf" type="text" description="name of color profile to convert to. Either a string specifying a specific color profile or &apos;Working RGB&apos;, &apos;Working CMYK&apos;, &apos;Working Gray&apos;, &apos;Lab Color&apos; meaning one of the working color spaces or Lab color"/>
			<parameter name="intent" code="Itnt" type="e130" description="conversion intent"/>
			<parameter name="blackpoint compensation" code="BpCp" type="boolean" optional="yes" description="use black point compensation?"/>
			<parameter name="dithering" code="pDtr" type="boolean" optional="yes" description="use dither? ( default: true )"/>
		</command>
		<command name="convert to shape" code="8BIMCv2s" description="converts the text object and its containing layer to a fill layer with the text changed to a clipping path">
			<direct-parameter type="text-object" description="the text-object object or objects to be operated upon"/>
		</command>
		<command name="create PDF presentation" code="8BIMPDF1" description="create a PDF presentation file">
			<parameter name="from files" code="PDF2" description="list of input files to include in the output">
				<type type="alias" list="yes"/>
			</parameter>
			<parameter name="to file" code="PDF3" type="file specification" description="location of the output file"/>
			<parameter name="with options" code="FmOp" type="presentation options" optional="yes" description="options for the PDF presentation"/>
			<result type="text" description="create a PDF presentation file"/>
		</command>
		<command name="create contact sheet" code="8BIMCTSH" description="create a contact sheet from multiple files">
			<parameter name="from files" code="PDF2" description="list of input files to include">
				<type type="alias" list="yes"/>
			</parameter>
			<parameter name="with options" code="FmOp" type="contact sheet options" optional="yes" description="options for Contact Sheet"/>
			<result type="text" description="create a contact sheet from multiple files"/>
		</command>
		<command name="create photo gallery" code="8BIMwwpg" description="Creates a web photo gallery">
			<parameter name="from folder" code="PG35" type="any" description="folder to process or an array of files to process"/>
			<parameter name="to folder" code="PG36" type="alias" description="location for output files"/>
			<parameter name="with options" code="FmOp" type="gallery options" optional="yes" description="options for the web photo gallery"/>
			<result type="text" description="Creates a web photo gallery"/>
		</command>
		<command name="create photo merge" code="8BIMptmg" description="DEPRECATED. Merges multiple files into one, user interaction required.">
			<parameter name="from files" code="PDF2" description="list of input files to include">
				<type type="alias" list="yes"/>
			</parameter>
			<result type="text" description="DEPRECATED. Merges multiple files into one, user interaction required."/>
		</command>
		<command name="create picture package" code="8BIMPTPK" description="create a picture package from multiple files">
			<parameter name="from files" code="PDF2" description="list of input files to include">
				<type type="alias" list="yes"/>
			</parameter>
			<parameter name="with options" code="FmOp" type="picture package options" optional="yes" description="options for Picture Package"/>
			<result type="text" description="create a picture package from multiple files"/>
		</command>
		<command name="create work path" code="8BIMCWpt" description="creates a work path based on the text object">
			<direct-parameter type="text-object" description="the text-object object or objects to be operated upon"/>
		</command>
		<command name="crop" code="8BIMCrop" description="crop the document">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="bounds" code="Bnds" type="list" description="area to crop (unit value)"/>
			<parameter name="angle" code="Angl" type="real" optional="yes" description="angle of cropping bounds ( default: 0.0 )"/>
			<parameter name="width" code="Wdth" type="real" optional="yes" description="width of resulting document (unit value)"/>
			<parameter name="height" code="Hght" type="real" optional="yes" description="height of resulting document (unit value)"/>
		</command>
		<command name="deselect" code="8BIMDslt">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
		</command>
		<command name="doc duplicate" code="8BIMdcdu" description="duplicate this document with parameters">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="name" code="pnam" type="text" optional="yes" description="name for the new document"/>
			<parameter name="merge layers only" code="MLON" type="boolean" optional="yes" description="duplicate merged layers only"/>
			<result type="document" description="duplicate this document with parameters"/>
		</command>
		<command name="expand" code="8BIMXpnd" description="expand selection">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="by" code="by  " type="real" description="distance to expand the selection by (unit value)"/>
		</command>
		<command name="export" code="8BIMExpr">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="in" code="kfil" type="file specification" description="the file to export to"/>
			<parameter name="as" code="fltp" type="e640" optional="yes" description="the type of export ( default: Illustrator paths )"/>
			<parameter name="with options" code="FmOp" type="export options" optional="yes" description="options for the export type specified"/>
		</command>
		<command name="feather" code="8BIMFthr" description="feather edges of selection">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="by" code="by  " type="real" description="amount to feather the edge by (unit value)"/>
		</command>
		<command name="feature enabled" code="8BIMften" description="is the feature with the given name enabled?">
			<parameter name="name" code="pnam" type="text" description="name of the feature"/>
			<result type="boolean" description="is the feature with the given name enabled?"/>
		</command>
		<command name="fill" code="8BIMFill" description="fills the selection">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="with contents" code="FCnt" type="any" description="a color or a history state"/>
			<parameter name="blend mode" code="BlMd" type="e925" optional="yes" description="( default: normal )"/>
			<parameter name="opacity" code="Opct" type="integer" optional="yes" description="( default: 100 )"/>
			<parameter name="preserving transparency" code="KpTr" type="boolean" optional="yes"/>
		</command>
		<command name="flatten" code="8BIMFltn" description="Flattens all visible layers in the document.">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
		</command>
		<command name="flip canvas" code="8BIMFlCv" description="flip the canvas horizontally or vertically">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="direction" code="Drtn" type="e140" description="which way to flip the canvas"/>
		</command>
		<command name="grow" code="8BIMGrow" description="grow selection to include all adjacent pixels falling within the specified tolerance range">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="tolerance" code="TlRc" type="integer" description="( 0 - 255 )"/>
			<parameter name="antialiasing" code="UsAA" type="boolean"/>
		</command>
		<command name="import annotations" code="8BIMIpAn" description="import annotations into the document">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="from" code="from" type="alias" description="document to import annotations from"/>
		</command>
		<command name="invert" code="8BIMIvSl" description="invert the selection">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
		</command>
		<command name="link" code="8BIMlkTo" description="link the layer with another layer">
			<direct-parameter type="layer" description="the layer object or objects to be operated upon"/>
			<parameter name="with" code="with" type="layer" description="layer to link to"/>
		</command>
		<command name="load" code="8BIMLdSl" description="load the selection from a channel">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="from" code="from" type="channel" description="the channel to load the selection from"/>
			<parameter name="combination type" code="STpe" type="e630" optional="yes" description="how to combine the channel contents with the existing selection ( default: replaced )"/>
			<parameter name="inverting" code="iVrt" type="boolean" optional="yes" description="select the inverse of the channel contents? ( default: false )"/>
		</command>
		<command name="make work path" code="8BIMPT16" description="make this selection item the work path for this document">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="tolerance" code="TlRc" type="real" optional="yes" description="tolerance in pixels"/>
		</command>
		<command name="merge" code="8BIMMgLZ" description="Merges an art layer or layer set into the layer below, or merges a spot channel into the component channels. Merging a layer or layer set returns a reference to the resulting layer. Merging a channel does not return any value.">
			<direct-parameter type="channel" description="the channel object or objects to be operated upon"/>
		</command>
		<command name="merge visible layers" code="8BIMMvsb" description="flatten all visible layers in the document">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
		</command>
		<command name="purge" code="8BIMPurg" description="purges one or more caches">
			<direct-parameter type="e150" description="what to purge"/>
		</command>
		<command name="rasterize" code="8BIMRstr">
			<direct-parameter type="art layer" description="the art layer object or objects to be operated upon"/>
			<parameter name="affecting" code="RzTg" type="e510" description="what to rasterize"/>
		</command>
		<command name="recapture" code="8BIMPG02" description="recapture the current layer state(s) for this layer comp">
			<direct-parameter type="layer comp" description="the layer comp object or objects to be operated upon"/>
		</command>
		<command name="record measurements" code="8BIMME04" description="record measurements of document">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="source" code="Di12" type="ME00" optional="yes" description="source of the measurements to record"/>
			<parameter name="data points" code="ME05" optional="yes" description="array of identifiers of data points to record.  Any data points not appropriate for the specified source will be ignored">
				<type type="text" list="yes"/>
			</parameter>
		</command>
		<command name="refresh" code="8BIMRfsh" description="pause the script until the application refreshes"/>
		<command name="reset from comp" code="8BIMPG62" description="reset the layer comp state to the document state">
			<direct-parameter type="layer comp" description="the layer comp object or objects to be operated upon"/>
		</command>
		<command name="resize canvas" code="8BIMRzCv" description="change the size of the canvas">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="width" code="Wdth" type="real" optional="yes" description="desired width of canvas (unit value)"/>
			<parameter name="height" code="Hght" type="real" optional="yes" description="desired height of canvas (unit value)"/>
			<parameter name="anchor position" code="Achr" type="e160" optional="yes" description="anchor to resize around ( default: middle center )"/>
		</command>
		<command name="resize image" code="8BIMRzIm" description="change the size of the image">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="width" code="Wdth" type="real" optional="yes" description="desired width of image (unit value)"/>
			<parameter name="height" code="Hght" type="real" optional="yes" description="desired height of image (unit value)"/>
			<parameter name="resolution" code="ResL" type="real" optional="yes" description="(in pixels per inch)"/>
			<parameter name="resample method" code="RzMt" type="e175" optional="yes" description="what method should be used for resampling pixels ( default: bicubic )"/>
			<parameter name="amount" code="Amnt" type="integer" optional="yes" description="amount of noise value when using preserve details (range: 0 - 100) ( 0 - 100; default: 0 )"/>
		</command>
		<command name="reveal all" code="8BIMRvAl" description="expand document to show clipped sections">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
		</command>
		<command name="rotate" code="8BIMRota">
			<direct-parameter type="layer" description="the layer object or objects to be operated upon"/>
			<parameter name="angle" code="Angl" type="real"/>
			<parameter name="anchor position" code="Achr" type="e160" optional="yes" description="point to rotate about ( default: middle center )"/>
		</command>
		<command name="rotate boundary" code="8BIMRotB" description="rotates the boundary of selection">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="angle" code="Angl" type="real"/>
			<parameter name="anchor position" code="Achr" type="e160" optional="yes" description="point to rotate about ( default: middle center )"/>
		</command>
		<command name="rotate canvas" code="8BIMRtCv" description="rotate canvas of document">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="angle" code="Angl" type="real" description="number of degrees to rotate. A positive angle will rotate the canvas clockwise; a negative value will rotate the canvas counter-clockwise"/>
		</command>
		<command name="scale" code="8BIMScle">
			<direct-parameter type="layer" description="the layer object or objects to be operated upon"/>
			<parameter name="horizontal scale" code="HrSc" type="real" optional="yes" description="percentage ( default: 100.0 )"/>
			<parameter name="vertical scale" code="VtSc" type="real" optional="yes" description="percentage ( default: 100.0 )"/>
			<parameter name="anchor position" code="Achr" type="e160" optional="yes" description="point to rotate about ( default: middle center )"/>
		</command>
		<command name="scale boundary" code="8BIMScBd" description="scale the boundary of selection">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="horizontal scale" code="HrSc" type="real" optional="yes" description="percentage ( default: 100.0 )"/>
			<parameter name="vertical scale" code="VtSc" type="real" optional="yes" description="percentage ( default: 100.0 )"/>
			<parameter name="anchor position" code="Achr" type="e160" optional="yes" description="point to scale about ( default: middle center )"/>
		</command>
		<command name="select" code="8BIMslct" description="change the selection">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="region" code="SRgn" description="list of corners of the selection (in pixels)">
				<type type="any" list="yes"/>
			</parameter>
			<parameter name="combination type" code="STpe" type="e630" optional="yes" description="how to combine the new selection with the existing selection ( default: replaced )"/>
			<parameter name="feather amount" code="FAmt" type="real" optional="yes" description="feather amount ( default: 0.0 )"/>
			<parameter name="antialiasing" code="UsAA" type="boolean" optional="yes" description="whether to use antialiasing ( default: true )"/>
		</command>
		<command name="select all" code="8BIMScAl" description="select the entire image">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
		</command>
		<command name="select border" code="8BIMBrdr" description="select the border of the selection">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="width" code="Wdth" type="real" description="width of border selection (unit value)"/>
		</command>
		<command name="similar" code="8BIMSmlr" description="grow selection to include pixels throughout the image falling within the tolerance range">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="tolerance" code="TlRc" type="integer"/>
			<parameter name="antialiasing" code="UsAA" type="boolean"/>
		</command>
		<command name="smooth" code="8BIMPSth">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="radius" code="Radi" type="integer" description="sample radius in pixels ( 0 - 100 )"/>
		</command>
		<command name="split channels" code="8BIMSpCh" description="split channels of the document">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<result description="split channels of the document">
				<type type="document" list="yes"/>
			</result>
		</command>
		<command name="store" code="8BIMSvSl" description="save the selection as a channel">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="into" code="into" type="channel" description="the channel to save the selection to"/>
			<parameter name="combination type" code="STpe" type="e630" optional="yes" description="how to add the selection to the existing contents of the channel ( default: replaced )"/>
		</command>
		<command name="stroke" code="8BIMStke" description="strokes the selection">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="using color" code="UsCr" type="any" description="color to stroke selection with"/>
			<parameter name="width" code="Wdth" type="integer" description="width of stroke (in pixels)"/>
			<parameter name="location" code="Lton" type="e920" optional="yes" description="( default: center )"/>
			<parameter name="blend mode" code="BlMd" type="e925" optional="yes" description="( default: normal )"/>
			<parameter name="opacity" code="Opct" type="integer" optional="yes" description="( default: 100 )"/>
			<parameter name="preserving transparency" code="KpTr" type="boolean" optional="yes"/>
		</command>
		<command name="translate" code="8BIMMvPs" description="moves the position relative to its current position">
			<direct-parameter type="layer" description="the layer object or objects to be operated upon"/>
			<parameter name="delta x" code="OfZX" type="real" optional="yes" description="horizontal transformation (unit value)"/>
			<parameter name="delta y" code="OfZY" type="real" optional="yes" description="vertical transformation (unit value)"/>
		</command>
		<command name="translate boundary" code="8BIMMvBd" description="moves the boundary of selection relative to its current position">
			<direct-parameter type="selection-object" description="the selection-object object or objects to be operated upon"/>
			<parameter name="delta x" code="OfZX" type="real" optional="yes" description="horizontal transformation (unit value)"/>
			<parameter name="delta y" code="OfZY" type="real" optional="yes" description="vertical transformation (unit value)"/>
		</command>
		<command name="trap" code="8BIMTrap" description="apply trap to a CMYK document">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="width" code="Wdth" type="integer" description="trap width in pixels"/>
		</command>
		<command name="trim" code="8BIMTrim">
			<direct-parameter type="document" description="the document object or objects to be operated upon"/>
			<parameter name="basing trim on" code="TrPx" type="e350" optional="yes" description="color or type of pixels to base trim on ( default: top left pixel )"/>
			<parameter name="top trim" code="TrTp" type="boolean" optional="yes" description="trim away top of document ( default: true )"/>
			<parameter name="left trim" code="TrLf" type="boolean" optional="yes" description="trim away left of document ( default: true )"/>
			<parameter name="bottom trim" code="TrBt" type="boolean" optional="yes" description="trim away bottom of document ( default: true )"/>
			<parameter name="right trim" code="TrRt" type="boolean" optional="yes" description="trim away right of document ( default: true )"/>
		</command>
		<command name="unlink" code="8BIMUlnk" description="unlink the layer">
			<direct-parameter type="layer" description="the layer object or objects to be operated upon"/>
		</command>
		<class name="art layer" code="cCLr" description="any layer that can contain data" inherits="layer" plural="art layers">
			<property name="properties" code="pALL" type="record" description="all of this object&apos;s properties returned in a single record"/>
			<property name="background layer" code="DbLr" type="boolean" description="is the layer a background layer?"/>
			<property name="fill opacity" code="FOpc" type="real" description="the interior opacity of the layer (between 0.0 and 100.0)"/>
			<property name="grouped" code="pGwP" type="boolean" description="is the layer grouped with the layer below?. Photoshop CS changed the menu name to Create/Release Clipping Mask"/>
			<property name="kind" code="Kind" type="e950" description="to create a text layer set this property to &apos;text layer&apos; on an empty art layer of type &apos;normal&apos;"/>
			<property name="pixels locked" code="PxLc" type="boolean"/>
			<property name="position locked" code="PtLc" type="boolean"/>
			<property name="text object" code="pLrT" type="text-object" access="r" description="the text that is associated with the art layer. Only valid for art layers whose &apos;kind&apos; is a text layer"/>
			<property name="transparent pixels locked" code="TpLc" type="boolean"/>
		</class>
		<class name="batch options" code="BT02" description="options for the Batch command">
			<property name="destination" code="BT06" type="BT14" description="final destination of processed files ( default: none )"/>
			<property name="destination folder" code="BT37" type="alias" description="folder location when using destination to a folder"/>
			<property name="error file" code="BT13" type="alias" description="file to log errors encountered, leave this blank to stop for errors"/>
			<property name="file naming" code="BT08" description="list of file naming options 6 max.">
				<type type="BT17" list="yes"/>
			</property>
			<property name="macintosh compatible" code="BT11" type="boolean" description="make final file name Macintosh compatible ( default: true )"/>
			<property name="override open" code="BT03" type="boolean" description="override action open commands ( default: false )"/>
			<property name="override save" code="BT07" type="boolean" description="override save as action steps with destination specified here ( default: false )"/>
			<property name="startingserial" code="BT09" type="integer" description="starting serial number to use ( default: 1 )"/>
			<property name="suppress open" code="BT04" type="boolean" description="suppress file open options dialogs ( default: false )"/>
			<property name="suppressprofile" code="BT05" type="boolean" description="suppress color profile warnings ( default: false )"/>
			<property name="unix compatible" code="BT12" type="boolean" description="make final file name Unix compatible ( default: true )"/>
			<property name="windows compatible" code="BT10" type="boolean" description="make final file name Windows compatible ( default: true )"/>
		</class>
		<class name="Bitmap mode options" code="cBmC" description="Settings related to changing the document mode to Bitmap" inherits="change mode options">
			<property name="angle" code="Angl" type="real" description="only valid for &apos;halftone screen&apos; conversions"/>
			<property name="conversion method" code="CvMt" type="e860" description="( default: diffusion dither )"/>
			<property name="frequency" code="Fqcy" type="real" description="only valid for &apos;halftone screen&apos; conversions"/>
			<property name="pattern name" code="PaNm" type="text" description="only valid for &apos;custom pattern&apos; conversions"/>
			<property name="resolution" code="ResL" type="real" description="output resolution (in pixels per inch) ( default: 72.0 )"/>
			<property name="screen shape" code="ScSh" type="e870" description="only valid for &apos;halftone screen&apos; conversions"/>
		</class>
		<class name="change mode options" code="cBCO" description="used with options on the &apos;change mode&apos; command"/>
		<class name="channel" code="cCHn" description="A channel in a document. Can be either a component channel representing a color of the document color model or an alpha channel" plural="channels">
			<property name="best type" code="pbst" type="type" access="r" description="the best type for the object&apos;s value"/>
			<property name="class" code="pcls" type="type" access="r" description="the object&apos;s class"/>
			<property name="default type" code="deft" type="type" access="r" description="the default type for the object&apos;s value"/>
			<property name="index" code="pidx" type="integer" access="r" description="the index of this instance of the object"/>
			<property name="properties" code="pALL" type="record" description="all of this object&apos;s properties returned in a single record"/>
			<property name="channel color" code="pCCr" type="color value" description="color of the channel (not valid for component channels)"/>
			<property name="container" code="ctnr" type="specifier" access="r" description="the object&apos;s container"/>
			<property name="histogram" code="Hist" access="r" description="a histogram of values for the channel">
				<type type="integer" list="yes"/>
			</property>
			<property name="kind" code="Kind" type="e660" description="type of the channel"/>
			<property name="name" code="pnam" type="text" description="the channel&apos;s name"/>
			<property name="opacity" code="Opct" type="real" description="opacity of alpha channels (called solidity for spot channels)"/>
			<property name="visible" code="pVSb" type="boolean"/>
		</class>
		<class name="color sampler" code="CSS0" description="A color sampler in a document. See the color sampler tool." plural="color samplers">
			<property name="best type" code="pbst" type="type" access="r" description="the best type for the object&apos;s value"/>
			<property name="class" code="pcls" type="type" access="r" description="the object&apos;s class"/>
			<property name="default type" code="deft" type="type" access="r" description="the default type for the object&apos;s value"/>
			<property name="index" code="pidx" type="integer" access="r" description="the index of this instance of the object"/>
			<property name="properties" code="pALL" type="record" description="all of this object&apos;s properties returned in a single record"/>
			<property name="color sampler color" code="CSS2" type="color value" access="r" description="color of the color sampler"/>
			<property name="container" code="ctnr" type="specifier" access="r" description="the object&apos;s container"/>
			<property name="position" code="Orgn" type="list" access="r" description="position of the color sampler (unit value)"/>
		</class>
		<class name="contact sheet options" code="CS01" description="Options for the Contact Sheet command">
			<property name="across first" code="CS02" type="boolean" description="place the images horizontally first ( default: true )"/>
			<property name="auto spacing" code="CS03" type="boolean" description="auto space the images in the contact sheet ( default: true )"/>
			<property name="best fit" code="CS05" type="boolean" description="rotate images for best fit ( default: false )"/>
			<property name="caption" code="Di01" type="boolean" description="use the filename as a caption for the image ( default: true )"/>
			<property name="column count" code="PG77" type="integer" description="contact sheet columns ( default: 5 )"/>
			<property name="flatten final" code="CS04" type="boolean" description="flatten all layers in the final document ( default: true )"/>
			<property name="font" code="cFnt" type="PGa2" description="font used for the caption ( default: Arial )"/>
			<property name="font size" code="PG74" type="integer" description="font size used for the caption ( default: 12 )"/>
			<property name="height" code="Hght" type="integer" description="height of the resulting document in pixels ( default: 720 )"/>
			<property name="horizontal offset" code="HrOz" type="integer" description="horizontal spacing between images in pixels ( default: 1 )"/>
			<property name="mode" code="OMde" type="e905" description="document mode (Grayscale, RGB, CMYK or Lab) ( default: RGB )"/>
			<property name="resolution" code="ResL" type="real" description="the resolution of the document (in pixels per inch) ( default: 72.0 )"/>
			<property name="row count" code="PG78" type="integer" description="contact sheet rows ( default: 6 )"/>
			<property name="vertical offset" code="VtOz" type="integer" description="vertical spacing between images in pixels ( default: 1 )"/>
			<property name="width" code="Wdth" type="integer" description="width of the resulting document in pixels ( default: 576 )"/>
		</class>
		<class name="count item" code="CT03" description="A counted item in a document. See the counting tool." plural="count items">
			<property name="best type" code="pbst" type="type" access="r" description="the best type for the object&apos;s value"/>
			<property name="class" code="pcls" type="type" access="r" description="the object&apos;s class"/>
			<property name="default type" code="deft" type="type" access="r" description="the default type for the object&apos;s value"/>
			<property name="index" code="pidx" type="integer" access="r" description="the index of this instance of the object"/>
			<property name="properties" code="pALL" type="record" description="all of this object&apos;s properties returned in a single record"/>
			<property name="container" code="ctnr" type="specifier" access="r" description="the object&apos;s container"/>
			<property name="position" code="Orgn" type="list" access="r" description="position of count item (unit value)"/>
		</class>
		<class name="font" code="cFnt" description="An installed font" plural="fonts">
			<property name="best type" code="pbst" type="type" access="r" description="the best type for the object&apos;s value"/>
			<property name="class" code="pcls" type="type" access="r" description="the object&apos;s class"/>
			<property name="default type" code="deft" type="type" access="r" description="the default type for the object&apos;s value"/>
			<property name="index" code="pidx" type="integer" access="r" description="the index of this instance of the object"/>
			<property name="properties" code="pALL" type="record" description="all of this object&apos;s properties returned in a single record"/>
			<property name="family" code="pFFN" type="text" access="r" description="the font&apos;s family"/>
			<property name="name" code="pnam" type="text" access="r" description="The font&apos;s text face name"/>
			<property name="PostScript name" code="pPSN" type="text" access="r" description="the font&apos;s PostScript name"/>
			<property name="style" code="Styl" type="text" access="r" description="the font&apos;s style name"/>
		</class>
		<class name="gallery banner options" code="PG96" description="Options for the web photo gallery banner options">
			<property name="contact info" code="PG51" type="text" description="web photo gallery contact info ( default:  )"/>
			<property name="date" code="PG52" type="text" description="web photo gallery date ( default:  )"/>
			<property name="font" code="cFnt" type="PGa2" description="the font setting for the banner text ( default: Arial )"/>
			<property name="font size" code="PG74" type="integer" description="the size of the font for the banner text ( 1 - 7; default: 3 )"/>
			<property name="photographer" code="PG50" type="text" description="web photo gallery photographer ( default:  )"/>
			<property name="site name" code="PG49" type="text" description="web photo gallery site name ( default: Adobe Web Photo Gallery )"/>
		</class>
		<class name="gallery color options" code="PG99" description="Options for the web photo gallery colors">
			<property name="active link color" code="PG83" type="RGB color" description="active link color"/>
			<property name="background color" code="BgCr" type="RGB color" description="background color"/>
			<property name="banner color" code="PG81" type="RGB color" description="banner color"/>
			<property name="link color" code="PG84" type="RGB color" description="link color"/>
			<property name="text color" code="PG82" type="RGB color" description="text color"/>
			<property name="visited link color" code="PG85" type="RGB color" description="visited link color"/>
		</class>
		<class name="gallery images options" code="PG97" description="Options for the web photo gallery images">
			<property name="border" code="PG60" type="integer" description="the amount of border pixels you want between your images ( 0 - 99; default: 0 )"/>
			<property name="caption" code="Di01" type="boolean" description="generate a caption for the images ( default: false )"/>
			<property name="dimension" code="PG57" type="integer" description="resized image dimensions in pixels ( default: 350 )"/>
			<property name="font" code="cFnt" type="PGa2" description="font for the gallery images text ( default: Arial )"/>
			<property name="font size" code="PG74" type="integer" description="font size for the gallery images text ( 1 - 7; default: 3 )"/>
			<property name="image quality" code="PG59" type="integer" description="the quality setting for the JPEG image ( 0 - 12; default: 5 )"/>
			<property name="include copyright" code="PG65" type="boolean" description="include the copyright in the text for the gallery images ( default: false )"/>
			<property name="include credits" code="PG63" type="boolean" description="include the credits in the text for the gallery images ( default: false )"/>
			<property name="include file name" code="PG61" type="boolean" description="include the file name in the text for the gallery images ( default: true )"/>
			<property name="include title" code="PG64" type="boolean" description="include the title in the text for the gallery images ( default: false )"/>
			<property name="numeric links" code="PG55" type="boolean" description="add numeric links ( default: true )"/>
			<property name="resize constraint" code="PG58" type="PGa3" description="how should the image be constrained ( default: constrain both )"/>
			<property name="resize images" code="PG56" type="boolean" description="resize images data ( default: true )"/>
		</class>
		<class name="gallery options" code="PG95" description="Options for the web photo gallery command">
			<property name="banner options" code="PG54" type="gallery banner options" description="options related to banner settings"/>
			<property name="custom color options" code="PG47" type="gallery color options" description="options related to custom color settings"/>
			<property name="email address" code="PG39" type="text" description="the email address to show on the web page ( default:  )"/>
			<property name="images options" code="PG45" type="gallery images options" description="options related to images settings"/>
			<property name="layout style" code="PG38" type="text" description="the style to use for laying out the web page ( default: Centered Frame 1 - Basic )"/>
			<property name="preserve all metadata" code="PG53" type="boolean" description="save all of the metadata in the JPEG files ( default: false )"/>
			<property name="security options" code="PG48" type="gallery security options" description="options related to security settings"/>
			<property name="short extension" code="PG40" type="boolean" description="short web page extension .htm or long web page extension .html ( default: true )"/>
			<property name="size attributes" code="PG43" type="boolean" description="add width and height attributes for images ( default: true )"/>
			<property name="sub folders" code="PG42" type="boolean" description="include all files found in sub folders of the input folder ( default: true )"/>
			<property name="thumbnail options" code="PG46" type="gallery thumbnail options" description="options related to thumbnail settings"/>
			<property name="UTF8 encoding" code="PG41" type="boolean" description="web page should use UTF-8 encoding ( default: false )"/>
		</class>
		<class name="gallery security options" code="PGa0" description="Options for the web photo gallery security">
