	<suite name="Notifier Suite" code="EN03" description="Classes for working with notifiers">
		<class name="notifier" code="EN02" description="The parameters of the notifie" plural="notifiers">
			<property name="best type" code="pbst" type="type" access="r" description="the best type for the object&apos;s value"/>
			<property name="class" code="pcls" type="type" access="r" description="the object&apos;s class"/>
			<property name="default type" code="deft" type="type" access="r" description="the default type for the object&apos;s value"/>
			<property name="index" code="pidx" type="integer" access="r" description="the index of this instance of the object"/>
			<property name="properties" code="pALL" type="record" description="all of this object&apos;s properties returned in a single record"/>
			<property name="event" code="EN04" type="text" access="r" description="The id of the event, four characters or a unique string"/>
			<property name="event class" code="EN07" type="text" access="r" description="The class id the event applies to, four characters or a unique string. Allows you to distinguish between the same event applied to different classes."/>
