	<suite name="Miscellaneous Standards Suite" code="misc" description="Miscellaneous standard commands and classes">
		<command name="clear" code="miscdelo" description="clear current selection"/>
		<command name="copy" code="misccopy" description="copy current selection to the clipboard"/>
		<command name="copy merged" code="misckMrg" description="copy current selection to the clipboard. Include data in all visible layers."/>
		<command name="cut" code="misccut " description="cut current selection to the clipboard"/>
		<command name="do action" code="miscDoAc" description="play an action from the Actions Palette">
			<direct-parameter type="text" description="the name of the action to play (note that the case of letters in the Action name is important and must match the case of the name in the Actions palette)"/>
			<parameter name="from" code="from" type="text" description="the name of the action set containing the action being played (note that the case of letters in the Action Set name is important and must match the case of the name in the Actions palette)"/>
		</command>
		<command name="do javascript" code="miscDjxM" description="execute a JavaScript">
			<direct-parameter type="any" description="JavaScript code or file to execute"/>
			<parameter name="with arguments" code="JArg" optional="yes" description="arguments to pass to the JavaScript routine">
				<type type="any" list="yes"/>
			</parameter>
			<parameter name="show debugger" code="JXMd" type="e940" optional="yes" description="when should a debugger be shown? ( default: never )"/>
			<result type="text" description="execute a JavaScript"/>
		</command>
		<command name="paste" code="miscpast" description="paste clipboard into the current document">
			<parameter name="clipping to selection" code="ICSl" type="boolean" optional="yes" description="should contents be clipped to the current selection? ( default: false )"/>
		</command>
	</suite>
