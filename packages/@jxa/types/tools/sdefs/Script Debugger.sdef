  <!-- SCRIPT DEBUGGER SUITE -->
  <suite name="Script Debugger Suite" code="asDB">
    <!--
		<enumeration name="breakpoint states" code="bpST">
			<enumerator name="yes" code="yes " description="A breakpoint is set on this paragraph."/>
			<enumerator name="no" code="no  " description="A breakpoint is set not on this paragraph."/>
			<enumerator name="temporary breakpoint" code="tmpB" description="A temporary breakpoint is set on this paragraph."/>
			<enumerator name="inactive breakpoint" code="iacB" description="An inactive breakpoint is set on this paragraph."/>
		</enumeration>
		-->
    <enumeration name="hierarchy types" code="ADHT" description="The type of diagram shown in a dictionary window’s diagram pane.">
      <enumerator name="containment" code="asHE" description="The element containment diagram."/>
      <enumerator name="inheritance" code="asHI" description="The class inheritance diagram."/>
    </enumeration>
    <enumeration name="tab modes" code="eSBm" description="Tabs of panes and inspectors in a script window.">
      <enumerator name="none" code="none" description="No panes or inspectors are showing."/>
      <enumerator name="result and variables tab" code="eSB0" description="The Result &amp; Variables Tab is showing."/>
      <enumerator name="resources tab" code="eSB1" description="The Resources Tab is showing."/>
      <enumerator name="inspectors tab" code="eSB2" description="The Inspectors Tab is showing."/>
    </enumeration>
    <!--
		<enumeration name="alias types" code="ALKD" description="the type of alias Script Debugger uses to refer to the library">
			<enumerator name="absolute" code="abso" description="an absolute alias"/>
			<enumerator name="relative to document" code="prel" description="relative to owning document"/>
			<enumerator name="relative to editor" code="erel" description="relative to Script Debugger"/>
		</enumeration>
-->
    <enumeration name="execution states" code="ASDS" description="What a script is doing.">
      <enumerator name="executing" code="asDR" description="The script is executing."/>
      <enumerator name="stopped" code="asDS" description="The script is doing nothing; it is editable."/>
      <enumerator name="compiling" code="asDx" description="The script is in the middle of compilation."/>
      <enumerator name="loading" code="asDL" description="The script is in the middle of loading or storing."/>
      <enumerator name="paused" code="asDP" description="The script is paused in debug mode."/>
    </enumeration>
    <enumeration name="dictionary view modes" code="ASDV" description="Display mode of a dictionary window.">
      <enumerator name="dictionary view" code="aeDV" description="Dictionary mode."/>
      <enumerator name="explorer view" code="aeDX" description="Explorer mode."/>
      <enumerator name="object model view" code="aeDG" description="Object Model mode."/>
    </enumeration>
    <enumeration name="script types" code="ASFT" description="Formats in which a script can be saved.">
      <enumerator name="text script" code="asTs" description="Text."/>
      <enumerator name="compiled script" code="asCS" description="Compiled script file."/>
      <enumerator name="bundled compiled script" code="asCB" description="Compiled script bundle."/>
      <enumerator name="script application" code="asXB" description="Apple applet or droplet."/>
      <enumerator name="enhanced application" code="asXE" description="Enhanced applet or droplet."/>
    </enumeration>
    <enumeration name="log format types" code="ASLG" description="Logging formats.">
      <enumerator name="source code" code="kSRC" description="Log As Source."/>
      <enumerator name="AEPrint" code="avAP" description="Log As AEPrint."/>
      <enumerator name="raw code" code="asRE" description="Log As Raw (Chevron) Events."/>
    </enumeration>
    <enumeration name="explorer view types" code="ASRT" description="Ways of viewing the value of an explorer.">
      <enumerator name="source code" code="kSRC" description="Source view (Desc view for AppleScriptObjC)."/>
      <enumerator name="AEPrint" code="avAP" description="AEPrint view."/>
      <enumerator name="best" code="best" description="Best view."/>
    </enumeration>
    <enumeration name="parameter type" code="PRXT" description="handler parameter type.">
        <enumerator name="positional parameter" code="kPM0" description="A positional parameter: handlerName(p1, p2, ...)"/>
        <enumerator name="named parameter" code="kPM1" description="A named parameter: handlerName given {name:varName, ...}"/>
        <enumerator name="keyword parameter" code="kPM3" description="A keyword parameter: handlerName over p1 through p2 ..."/>
        <enumerator name="direct parameter" code="kPM2" description="Direct parameter to event handler: open theFiles"/>
    </enumeration>
    <enumeration name="handler type" code="HDXT" description="handler type.">
        <enumerator name="subroutine handler" code="kHM0" description="A AppleScript handler (subroutine)"/>
        <enumerator name="event handler" code="kHM1" description="An event handler"/>
    </enumeration>
    <enumeration name="line ending types" code="LNED" description="Line ending conversions when saving as a text file.">
      <enumerator name="legacy endings" code="eXX1" description="Converts all line endings and linefeeds to carriage returns."/>
      <enumerator name="macOS endings" code="eXX2" description="No conversion; line endings are linefeeds."/>
      <enumerator name="DOS endings" code="eXX3" description="No longer supported. Will trigger error."/>
      <enumerator name="mixed endings" code="eXX4" description="Deprecated. Uses 'macOS endings' instead."/>
    </enumeration>
    <!--
		<enumeration name="key form types" code="KEYf" description="the key forms available for this element collection">
			<enumerator name="key by index" code="eXY1" description="key by object index"/>
			<enumerator name="key relative" code="eXY2" description="key relative to other objects"/>
			<enumerator name="key test" code="eXY3" description="key using a test (whose)"/>
			<enumerator name="key by range" code="eXY4" description="key using a range of object indexes"/>
			<enumerator name="key by property" code="eXY5" description="key by property name"/>
			<enumerator name="key by name" code="eXY6" description="key by object name"/>
			<enumerator name="key by unique ID" code="exY7" description="key by unique ID value"/>
		</enumeration>
-->
    <enumeration name="dictionary search options" code="DSOP" description="Options for searching a dictionary, corresponding to the search field pop-up checkboxes.">
      <enumerator name="search suites" code="eX11" description="Search Suites."/>
      <enumerator name="search classes" code="eX12" description="Search Classes."/>
      <enumerator name="search events" code="eX13" description="Search Events."/>
      <enumerator name="search commands" code="eX14" description="Search Commands."/>
      <enumerator name="search types" code="eX15" description="Search Types."/>
      <enumerator name="search records" code="eX16" description="Search Records."/>
      <enumerator name="search enumerations" code="eX17" description="Search Enumerations."/>
      <enumerator name="search names" code="eX18" description="Search Names."/>
      <enumerator name="search descriptions" code="eX19" description="Search Descriptions."/>
      <enumerator name="search synonyms" code="eX1a" description="Search Synonyms."/>
      <enumerator name="search Apple event codes" code="eX1b" description="Search Apple Event codes."/>
      <documentation>
        <html><![CDATA[
				<p>Search options can be combined into a list; setting the dictionary window&#8217;s search string performs the search:</p>
<pre><span class="code">tell dictionary window "Finder Dictionary"
    set search options to {search names, search descriptions, search classes}
    set search string to "folder" -- <i>performs the search</i>
end tell
</span></pre>
<!-- [tmi!]
<p>To manipulate the list of search options relative to the existing list (rather than hard-coding a new list from scratch), use the <code>difference of</code> command from Late Night Software&#8217;s <a href="https://www.latenightsw.com/freeware/RecordTools/index.html">List &amp; Record Tools scripting addition</a>:</p>
<pre><span class="code">tell dictionary "Finder"
    <i>-- get the existing search options</i>
    set theOptions to get search options
    <i>-- remove unwanted options</i>
    set theOptions to difference of theOptions ¬
        and {search descriptions, search synonyms}
    <i>-- apply the new options</i>
    set search options to theOptions
    <i>-- search for a term</i>
    set search string to "folder"
end tell
-->
</span></pre>
			]]></html>
      </documentation>
    </enumeration>
<!--    <record-type name="script manifest info" code="__MF" description="A script’s dependencies, as presented in its Manifest."> 
      <property name="applications used" code="__Ap" type="file" access="r" description="Applications needed by the script."/>
      <property name="scripting additions used" code="__Ad" type="file" access="r" description="Scripting additions needed by the script."/>
      <property name="unknown Apple events" code="_8Ev" access="r" description="Unrecognized Apple events appearing in the script.">
        <type type="text" list="yes"/>
      </property>
    </record-type> -->
    <class name="script window" code="SCPT" inherits="window" description="The window displaying a document.">
      <cocoa class="SD8ScriptWindow"/>
      <documentation>
        <html><![CDATA[
				<p>
					A script window can contain multiple documents (scripts) as tabs. Script window properties that are really document properties apply to the current document (the frontmost tab).
				</p>
				]]></html>
      </documentation>
      <!-- Generic window properties -->
      <property name="current document" code="cDOC" type="document" access="rw" description="The script document being displayed in this window (in the frontmost tab, if the window has multiple documents).">
        <cocoa key="currentTab"/>
      </property>
      <property name="toolbar visible" code="pTBV" type="boolean" description="Whether the window’s toolbar is visible.">
        <cocoa key="AEToolbarVisible"/>
      </property>
      <!-- script window only properties -->
      <property name="tab index" code="pitx" type="integer" description="The index of a script window tab within its parent script window, from left to right. If there are no tabs, the index will be 1.">
          <cocoa key="AETabOrderedIndex"/>
      </property>
      <property name="tabbed" code="ptaB" type="boolean" description="Whether the window belongs to a window with more than one tab. If the window is tabbed, setting this property to false will detach this window so it becomes a top-level window by itself.">
          <cocoa key="AEIsTabbed"/>
      </property>
      <property name="parent window" code="pwiN" type="script window" description="The top-level script window this window belongs to. If the window has no tabs, or it is the active tab, the parent will be the window itself. Use this property to move script windows and tabs to other script windows.">
          <cocoa key="AEParentWindow"/>
      </property>
      <property name="parent bounds" code="pbnD" type="rectangle" description="The parent window’s bounding rectangle (left, top, right, bottom, measured from the upper left of the screen).">
        <cocoa key="AEBoundsAsQDRect"/>
      </property>
      <property name="content visible" code="pviS" type="boolean" access="r" description="Whether a script window is visible, or in the case of a script window tab, whether it is the visible tab.">
        <cocoa key="AEIsVisible"/>
      </property>


      <!-- material repeated in both document and script window -->

      <property name="selection" code="psel" description="The current selection within the script’s source text.">
        <cocoa key="AESelection"/>
        <documentation>
          <html><![CDATA[
				<p>
				If you <span class="code">get selection</span>, you are handed the selected text. If you ask for <span class="code">selection as point</span> or <span class="code">character range of selection</span>, you get a list of two integers, the character offset after the insertion point or the start of the selection (the first character offset is 1) and the count of characters in the selection. Similarly, you can <span class="code">set selection</span> to alter the selected text, but if what you set the selection to is a list of two integers, or if you <span class="code">set character range of selection</span> to such a list, you reposition the selection.
				</p>
				]]></html>
        </documentation>
        <type type="selection-object"/>
        <type type="point"/>
        <type type="text"/>
        <!--<type type="specifier"/>-->
      </property>
      <property name="show code coverage" code="pSHp" type="boolean" description="Whether code coverage marks are displayed in the gutter of the script (in debug mode).">
        <cocoa key="AECodeCoverage"/>
      </property>
      <property name="navigation bar visible" type="boolean" code="pNBV" description="Whether the navigation bar is visible above the script.">
        <cocoa key="AEShowNavigationBar"/>
      </property>
      <property name="status bar visible" type="boolean" code="pSTV" description="Whether the status bar is visible below the script.">
          <cocoa key="AEShowStatusBar"/>
      </property>
      <property name="tab width" code="pSBw" type="integer" description="Width of the panes and inspectors tab to the right of the script (0 if tab display mode is none).">
        <cocoa key="AESidebarWidth"/>
      </property>
      <property name="tab display mode" type="tab modes" code="pSBm" description="Which set of panes and inspectors is displayed to the right of the script.">
        <cocoa key="AESidebarMode"/>
      </property>
      <property name="result format" code="pRx0" description="Which view (best, source, or AEPrint) the result explorer is in.">
        <cocoa key="AEResultDisplayFormat"/>
        <type type="explorer view types"/>
      </property>
      <property name="result wrap lines" code="pRx1" type="boolean" description="Whether line wrapping is turned on for the result pane of the script.">
        <cocoa key="AEResultWrapLines"/>
      </property>
      <property name="result show invisibles" code="pRx2" type="boolean" description="Whether invisible characters are displayed in the result pane of the script.">
        <cocoa key="AEResultShowInvisibles"/>
      </property>
      <property name="result show tab stops" code="pRx3" type="boolean" description="Whether tab stops are displayed in the result pane of the script.">
        <cocoa key="AEResultShowTabStops"/>
      </property>
      <property name="result show spaces" code="pRx4" type="boolean" description="Whether space characters are displayed as dots in the result pane of the script (assuming invisible characters are being displayed in the result pane).">
        <cocoa key="AEResultShowSpaces"/>
      </property>
      <property name="result pretty print" code="pRx5" type="boolean" description="Whether lists and records are pretty-printed in the result pane of the script.">
        <cocoa key="AEResultPrettyPrint"/>
      </property>
      <property name="result show raw syntax" code="pRx6" type="boolean" description="Whether raw (“chevron”) Apple event codes are displayed in the result pane of the script.">
        <cocoa key="AEResultChevronSyntax"/>
      </property>
      <property name="result bar visible" code="pRBv" type="boolean" description="Whether the result bar is visible above the script.">
          <cocoa key="AEResultBarVisible"/>
      </property>
      <property name="event log visible" code="pEV1" type="boolean" description="Whether the event log pane is open below the script.">
        <cocoa key="AEEventLogVisible"/>
      </property>
      <property name="event log height" code="pEV2" type="integer" description="The height of the event log pane below the script.">
        <cocoa key="AEEventLogHeight"/>
      </property>


      <property name="event log level" code="pEVy" type="integer" description="The accumulated sum of start log and stop log commands.">
        <cocoa key="AELogLevel"/>
        <documentation>
          <html><![CDATA[
				<p>
				The log level starts out at 1 when a script begins executing. Each <span class="code">stop log</span> command decrements it (and returns the new level); each <span class="code">start log</span> command increments it (and returns the new level). When the log level is 0 or less, no logging takes place.
				</p>
				]]></html>
        </documentation>
      </property>
      <property name="event log scope bar visible" code="pEV3" type="boolean" description="Whether the scope bar is visible in the event log.">
        <cocoa key="AEEventLogScopeVisible"/>
      </property>
      <property name="append to log" code="pLAP" type="boolean" description="Whether logged data should be appended to the current contents of the event log the next time the script runs.">
        <cocoa key="AEAppendToLog"/>
      </property>
      <property name="event log format" code="pLgF" description="Display format for events in the event log (source code, raw code, or AEPrint).">
        <cocoa key="AEEventLogFormat"/>
        <type type="log format types"/>
      </property>
      <property name="event result explorer visible" code="pRVv" type="boolean" description="Whether the second pane of the event log is open, exploring the result of the selected event.">
        <cocoa key="AEShowResultViewer"/>
      </property>
      <property name="event result explorer width" code="pRVw" type="integer" description="The width of the second pane of the event log, exploring the result of the selected event.">
        <cocoa key="AEResultViewerWidth"/>
      </property>
      <property name="progress bar can appear" code="pPSw" type="boolean" description="Whether the window displays a progress bar when its script uses AppleScript's progress properties.">
          <cocoa key="AEProgressShowing"/>
      </property>
      <property name="selection ASObjC range" code="prnC" description="The position of the selection as a zero-based Cocoa range. Can be a list of two items or a record in the form {location:x, |length|:y}. Use this instead of the selection's &#8220;character range&#8221; if working in AppleScriptObjC.">
         <type type="any"/>
          <cocoa key="AECocoaRange"/>
          <documentation>
              <html><![CDATA[
                  <p>
                  If you <span class="code">get selection ASObjC range</span>, the result will be returned as a list, <span class="code">{x, y}</span>. If you <span class="code">get selection ASObjC range as record</span>, it will be returned as a record in the form <span class="code">{location:x, |length|:y}</span>. When using <span class="code">set selection ASObjC range</span>, you can pass either a list or record.
                  </p>
              ]]></html>
          </documentation>
      </property>

      <!-- end repeated material -->
      <element type="document">
        <cocoa key="orderedDocuments"/>
      </element>
    <element type="script window tab" access="r">
        <cocoa key="AETabbedWindows"/>
        <accessor style="name"/>
        <accessor style="index"/>
        <accessor style="range"/>
        <accessor style="relative"/>
        <accessor style="test"/>
    </element>
    </class>
    
    <class name="script window tab" code="Twin" inherits="script window" description="A tab belonging to a window.">
        <cocoa class="ScriptWindow"/>
    </class>


    <class name="script handler" code="cSCh" description="A handler in a script/script object.">
        <cocoa class="SDScriptHandler"/>
        
        <property name="class" type="type" code="pcls" description="The object&#8217;s class." access="r">
            <cocoa key="AEClass"/>
        </property>
        <property name="index" code="pidx" description="The handler&#8217;s index." access="r">
            <type type="integer"/>
        </property>
        <property name="name" code="pnam" description="The name of the handler." access="r">
            <cocoa key="name"/>
            <type type="text"/>
        </property>
        <property name="container" code="ctnr" description="The object containing this object." access="r">
            <cocoa key="AEContainer"/>
            <synonym name="parent" code="pare" hidden="yes"/>
            <type type="specifier"/>
        </property>
        <property name="contents" code="pcnt" description="The contents of the handler." hidden="yes"> <!-- replaced by 'source text', see #752 -->
            <cocoa key="AEContents"/>
            <type type="text"/>
        </property>
        <property name="source text" code="pSTX" type="text" description="The handler’s contents, as text.">
            <cocoa key="AESourceText"/>
            <type type="text"/>
        </property>
        <property name="handler type" code="hppT" description="The type of handler." access="r">
            <cocoa key="AEHandlerType"/>
            <type type="handler type"/>
        </property>
        <property name="properties" code="pALL" description="All the object&#8217;s properties returned as a record." access="r">
            <type type="record"/>
            <cocoa key="scriptingProperties"/>
        </property>

        <element type="handler parameter">
            <cocoa key="orderedHandlerParameters"/>
            <accessor style="index | name | range | relative | test"/>
        </element>

    </class>

    <class name="handler parameter" code="cHPm" description="A parameter to a handler.">
        <cocoa class="SDHandlerParameter"/>
        
        <property name="class" type="type" code="pcls" description="The object&#8217;s class." access="r">
            <cocoa key="AEClass"/>
        </property>
        <property name="index" code="pidx" description="The parameter&#8217;s index." access="r">
            <type type="integer"/>
        </property>
        <property name="name" code="pnam" description="The name of the parmeter." access="r">
            <cocoa key="name"/>
            <type type="text"/>
        </property>
        <property name="variable name" code="pvnm" description="The parameter's variable name within the handler." access="r">
            <cocoa key="AEVariableName"/>
            <type type="text"/>
        </property>
        <property name="parameter type" code="pppT" description="The type of parameter." access="r">
            <cocoa key="AEParameterType"/>
            <type type="parameter type"/>
        </property>
<!--
        <property name="positional parameter" code="pppm" description="Is this a positional parameter: handlerName(p1, p2, ...) or named: handler given {paramName:p1, paramName:p2, ...}." access="r">
            <cocoa key="AEPositional"/>
            <type type="boolean"/>
        </property>
        <property name="keyword parameter" code="ppkm" description="For named parameters, is the name a keyword (over, through, etc.)." access="r">
            <cocoa key="AEKeyword"/>
            <type type="boolean"/>
        </property>
        <property name="direct object parameter" code="ppdm" description="For event handlers, is this a direct obect parameter?" access="r">
            <cocoa key="AEDirectObject"/>
            <type type="boolean"/>
        </property>
-->
        <property name="container" code="ctnr" description="The object containing this object." access="r">
            <cocoa key="AEContainer"/>
            <synonym name="parent" code="pare" hidden="yes"/>
            <type type="specifier"/>
        </property>
        <property name="properties" code="pALL" description="All the object&#8217;s properties returned as a record." access="r">
            <type type="record"/>
            <cocoa key="scriptingProperties"/>
        </property>
        
    </class>

    <class name="script property" code="cSCp" plural="script properties" description="A property in a script/script object.">
        <cocoa class="SDScriptProperty"/>
        
        <property name="class" type="type" code="pcls" description="The object&#8217;s class." access="r">
            <cocoa key="AEClass"/>
        </property>
        <property name="index" code="pidx" description="The property&#8217;s index." access="r">
            <type type="integer"/>
        </property>
        <property name="name" code="pnam" description="The name of the property." access="r">
            <type type="text"/>
        </property>
        <property name="contents" code="pcnt" description="The contents of the property.">
            <cocoa key="AEContents"/>
            <type type="any"/>
        </property>
        <property name="source text" code="pSTX" type="text" description="The property’s contents, as text.">
            <cocoa key="AESourceText"/>
            <type type="text"/>
        </property>
        <property name="container" code="ctnr" description="The object containing this object." access="r">
            <cocoa key="AEContainer"/>
            <synonym name="parent" code="pare" hidden="yes"/>
            <type type="specifier"/>
        </property>
        <property name="type" code="type" description="The type of data stored in the property." access="r" hidden="yes">
            <!-- deprecated - retained for backward compatibility -->
            <cocoa key="AEType"/>
            <type type="type"/>
        </property>
        <property name="content type" code="cTYp" description="The type of data stored in the property." access="r">
            <cocoa key="AEType"/>
            <type type="type"/>
        </property>
        <property name="properties" code="pALL" description="All the object&#8217;s properties returned as a record." access="r">
            <type type="record"/>
            <cocoa key="scriptingProperties"/>
        </property>
        <element type="script property">
            <cocoa key="orderedScriptProperties"/>
            <accessor style="index | name | range | relative | test"/>
        </element>
        <element type="script handler">
            <cocoa key="orderedScriptHandlers"/>
            <accessor style="index | name | range | relative | test"/>
        </element>
    </class>

    <class name="dictionary window" code="cDCT" inherits="window" description="A dictionary window.">
      <cocoa class="RKDictionaryWindow"/>
      <property name="file spec" type="file" code="pFil" description="File URL of the application whose dictionary window this is.">
        <cocoa key="AEDictionaryFile"/>
        <documentation>
          <html><![CDATA[
				<p>
				Set the file spec to specify what application&#8217;s dictionary and object model is being shown. The easiest way is to use the <span class="code">path to application</span> scripting addition command. For example: <span class="code">set file spec of (make new dictionary window) to (get path to application "BBEdit")</span>
				</p>
				]]></html>
        </documentation>
      </property>
      <property name="display mode" type="dictionary view modes" code="pDVW" description="Which mode (Dictionary, Object Model, or Explorer) the window is displaying.">
        <cocoa key="AEDictionaryView"/>
      </property>
      <property name="toolbar visible" type="boolean" code="pTBV" description="Whether the window’s toolbar is visible.">
        <cocoa key="AEToolbarVisible"/>
      </property>
      <property name="dictionaries list visible" type="boolean" code="pALV" description="Whether the dictionaries list is showing at the left of the dictionary window.">
        <cocoa key="AEApplicationsListVisible"/>
      </property>
      <property name="dictionaries list width" type="integer" code="pALW" description="The width of the dictionaries list at the left of the dictionary window.">
        <cocoa key="AEApplicationsListWidth"/>
      </property>
      <property name="search string" type="text" code="seSt" description="The current search string.">
        <cocoa key="searchString"/>
        <documentation>
          <html><![CDATA[
				<p>
				Setting the search string performs the search (and the <span class="code">search results visible</span> property becomes true); setting it to the empty string, or missing value, cancels the search (and the <span class="code">search results visible</span> property becomes false).
				</p>
				]]></html>
        </documentation>
      </property>
      <property name="search string deprecated" type="text" code="pSCH" description="The current search string.">
        <cocoa key="searchString"/>
        <documentation>
            <html>
                <![CDATA[
                    <p><strong>This property has been deprecated.</strong>  Please use the `search string` property instead.</p>
                ]]>
            </html>
        </documentation>
      </property>
      <property name="search options" code="pSCo" description="The current search options.">
        <cocoa key="searchOptions"/>
        <type type="dictionary search options" list="yes"/>
      </property>
      <property name="search results visible" type="boolean" code="pSRV" description="Whether there is currently a search (see on the search string property)." access="r">
        <cocoa key="AESearchResultsVisible"/>
      </property>
      <property name="show inherited" code="pSIP" description="Whether inherited properties and elements are included in class descriptions in the info pane.">
        <cocoa key="showInherited"/>
        <type type="boolean"/>
      </property>
      <property name="show extra documentation" code="pSEd" description="Whether extra documentation is displayed in the info pane.">
        <cocoa key="showExtraDocumentation"/>
        <type type="boolean"/>
      </property>
      <property name="show raw syntax" code="pSHr" type="boolean" description="Whether Raw (“Chevron”) Syntax is turned on, causing raw Apple event codes to appear in the info pane.">
        <cocoa key="AEChevronSyntax"/>
      </property>
      <property name="diagram hierarchy" code="pDHC" description="Which hierarchy diagram appears in Object Model view.">
        <cocoa key="AEDictionaryHierarchy"/>
        <type type="hierarchy types"/>
      </property>
      <property name="text scale" code="pTXs" type="real" description="The scaling factor of text in the dictionary window’s info pane (1.0 is “normal”).">
        <cocoa key="AETextScale"/>
      </property>
      <property name="display format" type="explorer view types" code="pRsF" description="Which view (best, source, or AEPrint) the dictionary window’s application explorer displays.">
        <cocoa key="AEViewerDisplayFormat"/>
      </property>
      <property name="wrap lines" code="pWRl" type="boolean" description="Whether line wrapping is turned on in the dictionary window’s application explorer.">
        <cocoa key="AEWrapLines"/>
      </property>
      <property name="show invisibles" code="pSHi" type="boolean" description="Whether invisible characters are displayed in the dictionary window’s application explorer.">
        <cocoa key="AEShowInvisibles"/>
      </property>
      <property name="show tab stops" code="pSHt" type="boolean" description="Whether tab stops are displayed in the dictionary window’s application explorer.">
        <cocoa key="AEShowTabStops"/>
      </property>
      <property name="show spaces" code="pSHs" type="boolean" description="Whether space characters are displayed as dots in the dictionary window’s application explorer (assuming invisible characters are being displayed).">
        <cocoa key="AEShowSpaces"/>
      </property>
      <property name="pretty print" code="pPPR" type="boolean" description="Whether lists and records are pretty-printed in the dictionary window’s application explorer.">
        <cocoa key="AEPrettyPrint"/>
      </property>
    </class>
    <class name="explorer window" code="cVWN" inherits="window" description="An explorer window.">
      <cocoa class="RKViewerWindow"/>
      <property name="contents" code="pcnt" type="any" description="The value being displayed in the explorer window." access="r">
        <cocoa key="AEViewerContents"/>
      </property>
      <!-- commented out by order of Mark
			<property name="container" code="ctnr" type="specifier" description="The script document, dictionary, event log entry, or explorer that created this explorer window." access="r">
				<cocoa key="AEViewerContainer"/>
				<synonym name="parent" code="pare" hidden="yes"/>
			</property>
			-->
      <property name="display format" type="explorer view types" code="pRsF" description="Which view (best, source, or AEPrint) the explorer window displays.">
        <cocoa key="AEViewerDisplayFormat"/>
      </property>
      <property name="wrap lines" code="pWRl" type="boolean" description="Whether line wrapping is turned on in the explorer.">
        <cocoa key="AEWrapLines"/>
      </property>
      <property name="show invisibles" code="pSHi" description="Whether invisible characters are displayed in the explorer.">
        <cocoa key="AEShowInvisibles"/>
        <type type="boolean"/>
      </property>
      <property name="show tab stops" code="pSHt" type="boolean" description="Whether tab stops are displayed in the explorer.">
        <cocoa key="AEShowTabStops"/>
      </property>
      <property name="show spaces" code="pSHs" type="boolean" description="Whether space characters are displayed as dots in the explorer (assuming invisible characters are being displayed).">
        <cocoa key="AEShowSpaces"/>
      </property>
      <property name="changed" code="pCHX" type="boolean" description="Whether the explorer’s value has changed since it was last produced." access="r">
        <cocoa key="AEIsChanged"/>
      </property>
      <property name="pretty print" code="pPPR" type="boolean" description="Whether lists and records are pretty-printed in the explorer.">
        <cocoa key="AEPrettyPrint"/>
      </property>
      <property name="show raw syntax" code="pSHr" type="boolean" description="Whether raw (“chevron”) Apple event codes are displayed in the explorer.">
        <cocoa key="AEChevronSyntax"/>
      </property>
      <property name="toolbar visible" code="pTBV" type="boolean" description="Whether the window’s toolbar is visible.">
        <cocoa key="AEToolbarVisible"/>
      </property>
    </class>
    <class name="event log entry" plural="event log entries" code="cELe" description="An event and its reply as recorded in the event log.">
      <cocoa class="AppleEventProfile"/>
      <documentation>
        <html><![CDATA[
				<p>
				Logging is always turned on (unless you turn it off in code with the stop log command); the event log needn&#8217;t be visible in order to work with its entries. Each entry in the event log records data about a single Apple event and its reply. Thus, event log entries provide a way to learn about the Apple events performed during script execution.
				</p>
				<p>
				To open an event log entry result as a separate explorer window, open the event log entry; e.g., <span class="code">tell document 2 to open event log entry 1</span>.
				</p>
				]]></html>
      </documentation>
      <property name="event source" code="pEVS" type="text" access="r" description="The command that generated the event, in source format.">
        <cocoa key="eventSource"/>
      </property>
      <property name="event result" code="pEVR" type="value-object" access="r" description="The result of the event.">
        <cocoa key="AEResult"/>
      </property>
      <property name="event text result" code="pEVr" type="text" access="r" description="The result of the event in text form.">
        <cocoa key="AEResultText"/>
      </property>
      <property name="event target" code="pEVT" type="event log target" access="r" description="The application to which the event was sent.">
        <cocoa key="AETarget"/>
      </property>
      <property name="document" code="docu" type="document" description="The document whose script generated the event." access="r">
        <cocoa key="AEDocument"/>
      </property>
      <property name="event error number" code="pEVe" type="integer" access="r" description="Numeric code of the error returned from the event (or missing value if not an error).">
        <cocoa key="AEErrorNumber"/>
      </property>
      <property name="event error message" code="pEVm" type="text" access="r" description="Text message of the error returned from the event (or missing value if not an error).">
        <cocoa key="AEErrorMessage"/>
      </property>
      <property name="event source text" code="pEVx" type="selection-object" access="r" description="The selection in the script of the text that generated the event, when paused during debugging (missing value otherwise).">
        <cocoa key="AESourceText"/>
      </property>
      <property name="event log level" code="pEVy" type="integer" description="The accumulated sum of start log and stop log commands before this event, when paused during debugging (1 otherwise).">
        <cocoa key="AELogLevel"/>
        <documentation>
          <html><![CDATA[
				<p>
				The log level starts out at 1 when a script begins executing. Each <span class="code">stop log</span> command decrements it (and returns the new level); each <span class="code">start log</span> command increments it (and returns the new level). When the log level is 0 or less, no logging takes place.
				</p>
				]]></html>
        </documentation>
      </property>
      <property name="event duration" code="pEVd" type="real" access="r" description="The time spent sending this event and receiving the reply. The total of event durations is the Events time in the timer.">
        <cocoa key="AELogDuration"/>
      </property>
      <property name="event percentage" code="pEVp" type="real" access="r" description="The percentage of total script excution time spent sending this event and receiving the reply. The total of event percentages, subtracted from 100, is the AppleScript percentage in the timer.">
        <cocoa key="AELogPercentage"/>
      </property>
      <property name="event start" code="pEVA" type="real" access="r" description="The elapsed script execution time when the event was sent.">
        <cocoa key="AELogStart"/>
      </property>
      <property name="event end" code="pEVZ" type="real" access="r" description="The elapsed script execution time when the reply was received.">
        <cocoa key="AELogEnd"/>
      </property>
      <property name="properties" type="record" code="pALL" description="All the object’s properties returned as a record.">
        <cocoa key="scriptingProperties"/>
      </property>
      <responds-to command="open">
        <cocoa method="handleOpenScriptCommand:"/>
      </responds-to>
    </class>
    <class name="event log target" code="cELt" description="The application to which an event was sent by a script.">
      <cocoa class="AppleEventTarget"/>
      <documentation>
        <html><![CDATA[
				<p>
				A document (or its event log window) has event log targets, the applications targeted by the script; going the other way, an event log target points back to the document through its document property. An event log entry has an event log target, the application targeted by the event; going the other way, an event log target has event log entries, the events sent from that document&#8217;s script to that application.
				</p>
				<p>The event log target for a <span class="code">start log</span>, <span class="code">stop log</span>, or <span class="code">log</span> command is <span class="code">"'log' Commands"</span>.
				</p>
				]]></html>
      </documentation>
      <element type="event log entry" access="r">
        <cocoa key="orderedEventLogEntries"/>
        <accessor style="index"/>
        <accessor style="range"/>
        <accessor style="relative"/>
        <accessor style="test"/>
      </element>
      <property name="name" code="pnam" type="text" access="r" description="Name of the application (or &quot;'log' Commands&quot;).">
        <cocoa key="AEName"/>
      </property>
      <property name="file spec" type="file" code="pFil" access="r" description="File URL of the application.">
        <cocoa key="AEFileURL"/>
      </property>
      <property name="document" code="docu" type="document" description="The document whose script generated the event targeting the application." access="r">
        <cocoa key="AEDocument"/>
      </property>
      <property name="target duration" code="pETd" type="real" access="r" description="The total duration of all events targeting the application.">
        <cocoa key="AEDuration"/>
      </property>
      <property name="target percentage" code="pETp" type="real" access="r" description="Percentage of total event time spent targeting the application.">
        <cocoa key="AEPercentage"/>
      </property>
      <property name="properties" type="record" code="pALL" description="All the object’s properties returned as a record.">
        <cocoa key="scriptingProperties"/>
      </property>
    </class>
    <class name="event log window" code="cELw" inherits="window" description="An event log window.">
      <cocoa class="EventLogWindow"/>
      <documentation>
        <html><![CDATA[
				<p>
				To open an event log window, tell the document to <span class="code">make new event log window</span>.
				</p>
				]]></html>
      </documentation>
      <element type="event log entry" access="r">
        <cocoa key="orderedEventLogEntries"/>
        <accessor style="index"/>
        <accessor style="range"/>
        <accessor style="relative"/>
        <accessor style="test"/>
      </element>
      <element type="event log target" access="r">
        <cocoa key="orderedEventLogTargets"/>
        <accessor style="name"/>
        <accessor style="index"/>
        <accessor style="range"/>
        <accessor style="relative"/>
        <accessor style="test"/>
      </element>
      <!-- Generic window properties -->
      <property name="toolbar visible" code="pTBV" type="boolean" description="Whether the window’s toolbar is visible.">
        <cocoa key="AEToolbarVisible"/>
      </property>
      <property name="document" code="docu" type="document" description="The document whose event log is shown in the window." access="r">
        <cocoa key="AEEventLogDocument"/>
      </property>
      <property name="selected events" code="pLNv" description="The event log entries selected in the window.">
        <cocoa key="AESelectedEvents"/>
        <type type="event log entry" list="yes"/>
      </property>
      <!-- Event Log properties -->
      <!-- material repeated in document and script window and event log window -->

      <property name="event log level" code="pEVy" type="integer" description="The accumulated sum of start log and stop log commands.">
        <cocoa key="AELogLevel"/>
        <documentation>
          <html><![CDATA[
				<p>
				The log level starts out at 1 when a script begins executing. Each <span class="code">stop log</span> command decrements it (and returns the new level); each <span class="code">start log</span> command increments it (and returns the new level). When the log level is 0 or less, no logging takes place.
				</p>
				]]></html>
        </documentation>
      </property>
      <property name="event log scope bar visible" code="pEV3" type="boolean" description="Whether the scope bar is visible in the event log.">
        <cocoa key="AEEventLogScopeVisible"/>
      </property>
      <property name="append to log" code="pLAP" type="boolean" description="Whether logged data should be appended to the current contents of the event log the next time the script runs.">
        <cocoa key="AEAppendToLog"/>
      </property>
      <property name="event log format" code="pLgF" description="Display format for events in the event log (source code, raw code, or AEPrint).">
        <cocoa key="AEEventLogFormat"/>
        <type type="log format types"/>
      </property>
      <property name="event result explorer visible" code="pRVv" type="boolean" description="Whether the second pane of the event log is open, exploring the result of the selected event.">
        <cocoa key="AEShowResultViewer"/>
      </property>
      <property name="event result explorer width" code="pRVw" type="integer" description="The width of the second pane of the event log, exploring the result of the selected event.">
        <cocoa key="AEResultViewerWidth"/>
      </property>

      <!-- end repeated material -->
    </class>
<!-- Not in SD8
    <class name="AppleScript format" code="cASf" description="An AppleScript language element and its associated display formatting. These contain the values for the active color theme.">
      <cocoa class="AppleScriptFormat"/>
      <property name="index" type="integer" code="pidx" description="The object’s index. AppleScript formats are arranged in the same order in which they appear in Script Debugger’s Fonts &amp; Colors preference pane." access="r">
        <cocoa key="AEIndex"/>
      </property>
      <property name="name" type="text" code="pnam" description="The name of the AppleScript language element." access="r">
        <cocoa key="AEName"/>
      </property>
      <property name="color" code="colr" type="color" description="The color of the AppleScript language element." access="r">
        <cocoa key="AEColor"/>
      </property>
      <property name="font" code="font" type="text" description="The name of the font of the AppleScript language element." access="r">
        <cocoa key="AEFontName"/>
      </property>
      <property name="size" code="ptsz" type="integer" description="The size in points of the AppleScript language element." access="r">
        <cocoa key="AEFontSize"/>
      </property>
      <property name="properties" code="pALL" type="record" description="All the object’s properties returned as a record." access="r">
        <cocoa key="scriptingProperties"/>
      </property>
    </class>
-->
    <command name="compile" code="asDBCOMP" description="Compile a script (document).">
      <cocoa class="CompileCommand"/>
      <direct-parameter type="specifier" description="The script (document) to compile."/>
      <parameter name="showing errors" type="boolean" optional="yes" code="xSHe" description="Whether the script error sheet should be displayed if there is a compilation error (the default is false).">
        <cocoa key="ShowErrors"/>
      </parameter>
      <result description="Whether the script compiled successfully. If not, your code can probe the various document “last error...” properties to learn what went wrong." type="boolean"/>
    </command>
    <command name="execute" code="asDBRUN " description="Begin or resume running a script (document).">
      <cocoa class="ExecuteCommand"/>
      <direct-parameter type="specifier" description="The script (document) to execute."/>
      <documentation>
        <html><![CDATA[
			<p>
			Execution causes compilation. After calling <span class="code">execute</span>, you can check whether compilation succeeded by examining the document&#8217;s <span class="code">compiled</span> property.
			</p>
			<p>
			The <span class="code">execute</span> command can return before execution is complete (because of Script Debugger&#8217;s multi-threaded architecture). Therefore, to await the outcome after calling <span class="code">execute</span>, you must poll the document&#8217;s <span class="code">execution state</span> until execution has stopped.
			</p>
			<p>The following code example illustrates both these points, providing a general utility handler, <span class="code">waitUntilReady()</span>, that you can use in your scripts.
			</p>
<pre><span class="code">on waitUntilReady(d)
    repeat while execution state of d is not in {stopped, paused}
        delay 0.2
    end repeat
end waitUntilReady
<i>-- and here's how to use it</i>
tell application "Script Debugger"
    set d to document "myDocument"
    tell d
        execute
        my waitUntilReady(d)
        if not compiled then return last error message
        return last result
    end tell
end tell</span></pre>
			]]></html>
      </documentation>
    </command>
    <command name="halt" code="asDBSTOP" description="Abort running a script (document).">
      <cocoa class="HaltCommand"/>
      <direct-parameter type="specifier" description="The script (document) to stop running."/>
    </command>
    <command name="refresh" code="asDBREFR" description="Reload a value displayed by an explorer.">
      <cocoa class="NSScriptCommand"/>
      <direct-parameter type="specifier" description="The value to refresh."/>
    </command>
    <command name="pause" code="asDBPAUS" description="Pause a script (document) at the next statement (in debug mode).">
      <cocoa class="PauseCommand"/>
      <direct-parameter type="specifier" description="The script (document) to pause."/>
      <documentation>
        <html><![CDATA[
			<p>
			This command can return before execution is complete (because of Script Debugger&#8217;s multi-threaded architecture). Therefore, after calling it, you must poll the document&#8217;s <span class="code">execution state</span> until execution has stopped. See on the <a class="internal" href="ref:///execute">execute</a> command for a utility handler showing how to do this.
			</p>
			]]></html>
      </documentation>
    </command>
    <command name="step into" code="asDBSTPi" description="Step a script (document) into a handler call (in debug mode).">
      <cocoa class="StepIntoCommand"/>
      <direct-parameter type="specifier" description="The script (document) in which to step."/>
      <documentation>
        <html><![CDATA[
			<p>
			This command can return before execution is complete (because of Script Debugger&#8217;s multi-threaded architecture). Therefore, after calling it, you must poll the document&#8217;s <span class="code">execution state</span> until execution has stopped. See on the <a class="internal" href="ref:///execute">execute</a> command for a utility handler showing how to do this.
			</p>
			]]></html>
      </documentation>
    </command>
    <command name="step over" code="asDBSTPo" description="Step a script (document) over a handler call (in debug mode).">
      <cocoa class="StepOverCommand"/>
      <direct-parameter type="specifier" description="The script (document) in which to step."/>
      <documentation>
        <html><![CDATA[
			<p>
			This command can return before execution is complete (because of Script Debugger&#8217;s multi-threaded architecture). Therefore, after calling it, you must poll the document&#8217;s <span class="code">execution state</span> until execution has stopped. See on the <a class="internal" href="ref:///execute">execute</a> command for a utility handler showing how to do this.
			</p>
			]]></html>
      </documentation>
    </command>
    <command name="step out" code="asDBSTPx" description="Step a script (document) out of the current handler (in debug mode).">
      <cocoa class="StepOutCommand"/>
      <direct-parameter type="specifier" description="The script (document) in which to step."/>
      <documentation>
        <html><![CDATA[
			<p>
			This command can return before execution is complete (because of Script Debugger&#8217;s multi-threaded architecture). Therefore, after calling it, you must poll the document&#8217;s <span class="code">execution state</span> until execution has stopped. See on the <a class="internal" href="ref:///execute">execute</a> command for a utility handler showing how to do this.
			</p>
			]]></html>
      </documentation>
    </command>
    <command name="direct export" code="asDBexDi" description="Export a run-only copy of a document.">
      <cocoa class="DirectExportCommand"/>
      <direct-parameter type="specifier" description="The document to export."/>
      <parameter name="as" code="fltp" type="script types" optional="yes" description="The format for the saved file. The default is the same format as the file, or as an Apple Applet for .applescript files.">
        <cocoa key="FileType"/>
      </parameter>
      <result description="The exported run-only file." type="file"/>
    </command>
    
    <enumeration name="search types" code="seTy" description="The type of search to conduct.">
      <enumerator name="find first" code="seFi" description="Find the first match in the document."/>
      <enumerator name="find next" code="seFn" description="Find the next match after the selection in the document."/>
      <enumerator name="find previous" code="seFp" description="Find the first match before the selection in the document."/>
      <enumerator name="find last" code="seFl" description="Find the last match in the document."/>
      <enumerator name="replace and find" code="seRf" description="Replace the selection and find the next match in the document."/>
      <enumerator name="replace all" code="seRa" description="Replace all matches in the document, from the selection to the end, or in the entire document if the application property ‘search wraps’ is true."/>
    </enumeration>
    <command name="search" code="asDBfiNd" description="Search the contents of a document, with the option to replace. The search string and other parameters are set as properties of the application.">
      <cocoa class="SearchCommand"/>
      <direct-parameter type="specifier" description="The document to search."/>
      <parameter name="with action" type="search types" optional="yes" code="seTy" description="The type of search to conduct. The default is ‘find next’.">
        <cocoa key="SearchType"/>
      </parameter>
      <result description="Returns the selection range of the found match expressed as a list, {character offset, length}, or missing value if not found. It also selects the found text. When performing ‘replace all’ it returns the number of replacements made.">
          <type type="integer" list="yes"/>
          <type type="integer"/>
    </result>
  </command>

  </suite>
  <!--
	<suite name="External Editor Suite" code="edit" description="external script editor interface">
		<command name="OM edit script" code="editedit" description="edit an external script">
			<result description="reference to the new external editor window" type="specifier"/>
			<direct-parameter description="object refering to the script to be edited" type="specifier"/>
			<parameter name="titled" code="ASwt" description="external editor window title" optional="yes" type="string"/>
			<parameter name="notify close" code="ASnc" description="notify client applicaiton when window is closed?" optional="yes" type="boolean"/>
			<parameter name="in background" code="ASna" description="keep Script Debugger in the abckground?" optional="yes" type="boolean"/>
		</command>
		<command name="NOM edit script" code="editEDIT" description="edit an external script">
			<result description="reference to the new external editor window" type="specifier"/>
			<parameter name="script" code="ASse" description="the script to edit" type="scpt"/>
			<parameter name="session" code="ASid" description="unique editor session ID" type="any"/>
			<parameter name="titled" code="ASwt" description="external editor window title" optional="yes" type="string"/>
			<parameter name="notify close" code="ASnc" description="notify client applicaiton when window is closed?" optional="yes" type="boolean"/>
			<parameter name="in background" code="ASna" description="keep Script Debugger in the abckground?" optional="yes" type="boolean"/>
			<parameter name="using client terminology" code="ASct" description="make client application the default target?" optional="yes" type="boolean"/>
		</command>
	</suite>
-->
  <suite name="Hidden Suite" code="tpnm" description="hidden definitions" hidden="yes">
    <class name="reference" code="obj ">
      <cocoa class="NSScriptObjectSpecifier"/>
      <synonym name="specifier"/>
    </class>
    <!-- supports ASObjC compilation -->
    <class name="class" code="pcls" description="A class" plural="classes">
      <cocoa class="NSObject"/>
      <property name="name" code="pnam" description="The title of the class." type="text">
        <cocoa key="className"/>
      </property>
    </class>
  </suite>
</dictionary>
